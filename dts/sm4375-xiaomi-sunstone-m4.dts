// SPDX-License-Identifier: BSD-3-Clause
/*
 * Xiaomi Redmi Note 12 5G (sunstone), SM4375 "blair": milestone 4 tree = M3 + PMICs and keys.
 *
 * The board XO frequency (left to the board by sm6375.dtsi) was missing until M4: every clock
 * rate read 0, which broke cpufreq-hw (no OPPs) and the UFS ref clock setting.
 * PMICs as on the downstream DT and Sony's pdx225: PM6125 (SID 0/1), PMK8350 on SID 6, PMR735A.
 * Keys (downstream gpio-keys and qpnp-power-on): power = PM6125 PON KPDPWR, volume down = PM6125
 * PON RESIN, volume up = PMR735A GPIO1 (active low) -- the reverse of pdx225's volume keys.
 * RTC: PMK8350 (read-only for Linux; the offset to real time is kept in userspace).
 * Touch: FocalTech FT5452 at 0x38 on i2c8 (QUP1 SE2, GPIO19/20). TZ leaves that SE in GSI mode
 * (FIFO disabled), which i2c-qcom-geni handles through GPI DMA. Reset GPIO21, IRQ GPIO22, AVDD
 * switched by GPIO49 (downstream focaltech,avdd-gpio); the IO supply stays as ABL set it.
 */
#define PMK8350_SID 6

#include "sm4375-xiaomi-sunstone-m3.dts"
#include "pm6125.dtsi"
#include "pmk8350.dtsi"
#include "pmr735a.dtsi"

/* the PM6125 PON is the one in use (downstream disables PMK8350's), and the labels collide */
/delete-node/ &pmk8350_pon;

/ {
	model = "Xiaomi Redmi Note 12 5G (sunstone), milestone 4";

	/* the touch controller's analog supply, switched by GPIO49; on already when ABL hands over */
	touch_avdd: touch-avdd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "touch_avdd";
		gpio = <&tlmm 49 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		pinctrl-0 = <&ts_avdd_default>;
		pinctrl-names = "default";
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "gpio-keys";
		pinctrl-0 = <&vol_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pmr735a_gpios 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};
};

&gpi_dma1 {
	status = "okay";
};

&qupv3_id_1 {
	status = "okay";
};

&i2c8 {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@38 {
		compatible = "focaltech,ft5452";
		reg = <0x38>;
		interrupts-extended = <&tlmm 22 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 21 GPIO_ACTIVE_LOW>;
		vcc-supply = <&touch_avdd>;
		/* the IC reports 1.25x panel pixels (boot-11 target taps: 0.805 px per unit, both axes) */
		touchscreen-size-x = <1350>;
		touchscreen-size-y = <3000>;
		pinctrl-0 = <&ts_int_default &ts_reset_default>;
		pinctrl-names = "default";
	};
};

&tlmm {
	ts_reset_default: ts-reset-default-state {
		pins = "gpio21";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	ts_int_default: ts-int-default-state {
		pins = "gpio22";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_avdd_default: ts-avdd-default-state {
		pins = "gpio49";
		function = "gpio";
		drive-strength = <8>;
		output-high;
	};
};

&xo_board_clk {
	clock-frequency = <19200000>;
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&pmr735a_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio1";
		function = "normal";
		power-source = <1>;
		bias-pull-up;
		input-enable;
	};
};

&pmk8350_rtc {
	status = "okay";
};

/* blair's gold cluster tops out at 2016 MHz (EPSS LUT), a step holi's table does not have */
&cpu6_opp_table {
	opp-2016000000 {
		opp-hz = /bits/ 64 <2016000000>;
		opp-peak-kBps = <(1497600 * 32)>;
	};
};

/* not used on this board: the PM6125 RTC is disabled in hardware (probe gets -EPERM), and the
 * PMK8350 ADC has no channels described yet */
&pm6125_rtc {
	status = "disabled";
};

&pmk8350_vadc {
	status = "disabled";
};
