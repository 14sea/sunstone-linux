regulator: add a Will Semiconductor WL2866D driver

The WL2866D has four I2C controlled LDOs for camera modules: LDO1 and
LDO2 (0.6 V + n * 6 mV) for the sensors' digital cores, LDO3 and LDO4
(1.2 V + n * 12.5 mV) for their analog supplies. On the Xiaomi Redmi
Note 12 5G (sunstone) it powers the main sensor (LDO1 + LDO3), the 8 MP
sensor (LDO2 + LDO4) and the 2 MP sensor (LDO4).

Register map as in the vendor kernels (Motorola's wl2866d-regulator,
Xiaomi's wl2866d): VOUT at 0x03..0x06, enables in 0x0e[3:0], output
discharge in 0x02[3:0].

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index 89789ac7a..b2f93dae1 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -1858,6 +1858,14 @@ config REGULATOR_VQMMC_IPQ4019
 	  This driver provides support for the VQMMC LDO I/0
 	  voltage regulator of the IPQ4019 SD/EMMC controller.
 
+config REGULATOR_WL2866D
+	tristate "Will Semiconductor WL2866D camera LDOs"
+	depends on I2C && OF
+	select REGMAP_I2C
+	help
+	  This driver supports the Will Semiconductor WL2866D, four I2C
+	  controlled LDOs that power camera modules.
+
 config REGULATOR_WM831X
 	tristate "Wolfson Microelectronics WM831x PMIC regulators"
 	depends on MFD_WM831X
diff --git a/drivers/regulator/Makefile b/drivers/regulator/Makefile
index 5a764cec8..1db60efce 100644
--- a/drivers/regulator/Makefile
+++ b/drivers/regulator/Makefile
@@ -212,6 +212,7 @@ obj-$(CONFIG_REGULATOR_RZG2L_VBCTRL) += renesas-usb-vbus-regulator.o
 obj-$(CONFIG_REGULATOR_VCTRL) += vctrl-regulator.o
 obj-$(CONFIG_REGULATOR_VEXPRESS) += vexpress-regulator.o
 obj-$(CONFIG_REGULATOR_VQMMC_IPQ4019) += vqmmc-ipq4019-regulator.o
+obj-$(CONFIG_REGULATOR_WL2866D) += wl2866d-regulator.o
 obj-$(CONFIG_REGULATOR_WM831X) += wm831x-dcdc.o
