diff --git a/drivers/regulator/wl2866d-regulator.c b/drivers/regulator/wl2866d-regulator.c
new file mode 100644
index 000000000..7604c9969
--- /dev/null
+++ b/drivers/regulator/wl2866d-regulator.c
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Will Semiconductor WL2866D: four LDOs for camera modules (I2C).
+ *
+ * LDO1/LDO2 (supply VIN1) 0.6 V + n * 6 mV, LDO3/LDO4 (supply VIN2) 1.2 V + n * 12.5 mV, n the
+ * 8-bit value of the LDO's VOUT register; bit n-1 of LDO_EN switches LDOn on, bit n-1 of DISCHARGE
+ * its output discharge resistor. Register map as in the vendor kernels (Motorola, Xiaomi).
+ */
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+
+#define WL2866D_CHIP_REV	0x00
+#define WL2866D_DISCHARGE	0x02
+#define WL2866D_LDO1_VOUT	0x03
+#define WL2866D_LDO_EN		0x0e
+#define WL2866D_SEQ_STATUS	0x0f
+
+static const struct regulator_ops wl2866d_ops = {
+	.list_voltage = regulator_list_voltage_linear,
+	.map_voltage = regulator_map_voltage_linear,
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.enable = regulator_enable_regmap,
+	.disable = regulator_disable_regmap,
+	.is_enabled = regulator_is_enabled_regmap,
+	.set_active_discharge = regulator_set_active_discharge_regmap,
+};
+
+#define WL2866D_LDO(_num, _supply, _min, _step)				\
+	{								\
+		.name = "ldo" #_num,					\
+		.of_match = "ldo" #_num,				\
+		.regulators_node = "regulators",			\
+		.supply_name = _supply,					\
+		.id = (_num) - 1,					\
+		.type = REGULATOR_VOLTAGE,				\
+		.owner = THIS_MODULE,					\
+		.ops = &wl2866d_ops,					\
+		.n_voltages = 256,					\
+		.min_uV = _min,						\
+		.uV_step = _step,					\
+		.vsel_reg = WL2866D_LDO1_VOUT + (_num) - 1,		\
+		.vsel_mask = 0xff,					\
+		.enable_reg = WL2866D_LDO_EN,				\
+		.enable_mask = BIT((_num) - 1),				\
+		.active_discharge_reg = WL2866D_DISCHARGE,		\
+		.active_discharge_mask = BIT((_num) - 1),		\
+		.active_discharge_on = BIT((_num) - 1),			\
+		.enable_time = 1000,					\
+	}
+
+static const struct regulator_desc wl2866d_regulators[] = {
+	WL2866D_LDO(1, "vin1", 600000, 6000),
+	WL2866D_LDO(2, "vin1", 600000, 6000),
+	WL2866D_LDO(3, "vin2", 1200000, 12500),
+	WL2866D_LDO(4, "vin2", 1200000, 12500),
+};
+
+static const struct regmap_config wl2866d_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = WL2866D_SEQ_STATUS,
+};
+
+static int wl2866d_probe(struct i2c_client *i2c)
+{
+	struct regulator_config config = { .dev = &i2c->dev };
+	struct regulator_dev *rdev;
+	struct regmap *regmap;
+	unsigned int rev;
+	int i, ret;
+
+	regmap = devm_regmap_init_i2c(i2c, &wl2866d_regmap);
+	if (IS_ERR(regmap))
+		return dev_err_probe(&i2c->dev, PTR_ERR(regmap), "regmap init failed\n");
+
+	ret = regmap_read(regmap, WL2866D_CHIP_REV, &rev);
+	if (ret)
+		return dev_err_probe(&i2c->dev, ret, "no answer\n");
+	dev_dbg(&i2c->dev, "chip revision 0x%02x\n", rev);
+
+	config.regmap = regmap;
+	for (i = 0; i < ARRAY_SIZE(wl2866d_regulators); i++) {
+		rdev = devm_regulator_register(&i2c->dev, &wl2866d_regulators[i], &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(&i2c->dev, PTR_ERR(rdev), "failed to register %s\n",
+					     wl2866d_regulators[i].name);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id wl2866d_of_match[] = {
+	{ .compatible = "willsemi,wl2866d" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, wl2866d_of_match);
+
+static const struct i2c_device_id wl2866d_id[] = {
+	{ "wl2866d" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, wl2866d_id);
+
+static struct i2c_driver wl2866d_driver = {
+	.driver = {
+		.name = "wl2866d",
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+		.of_match_table = wl2866d_of_match,
+	},
+	.probe = wl2866d_probe,
+	.id_table = wl2866d_id,
+};
+module_i2c_driver(wl2866d_driver);
+
+MODULE_DESCRIPTION("Will Semiconductor WL2866D camera LDO regulator driver");
+MODULE_LICENSE("GPL");
