+	{ 0x4601, 0xc8 }, { 0x4641, 0x3e }, { 0x4643, 0x0c }, { 0x480e, 0x00 },
+	{ 0x4837, 0x08 }, { 0x484b, 0x07 }, { 0x4850, 0x43 }, { 0x5000, 0x8d },
+	{ 0x5001, 0x23 }, { 0x5002, 0x9e }, { 0x5185, 0x0b }, { 0x5187, 0x00 },
+	{ 0x5188, 0x08 }, { 0x5198, 0x08 }, { 0x533d, 0x00 }, { 0x5880, 0x81 },
+	{ 0x5c00, 0x41 }, { 0x5c6d, 0x02 }, { 0x5c7a, 0x42 }, { 0x5c7b, 0x24 },
+	{ 0x5d0e, 0x02 }, { 0x5d0f, 0x06 }, { 0x5d10, 0x02 }, { 0x3046, 0x01 },
+};
+
+static const s64 ov48b2q_link_freqs[] = { OV48B2Q_LINK_FREQ };
+
+static const char * const ov48b2q_test_pattern_menu[] = {
+	"Disabled",
+	"Color Bars",
+};
+
+static const char * const ov48b2q_supply_names[] = {
+	"dovdd",	/* Digital I/O power */
+	"avdd",		/* Analog power */
+	"dvdd",		/* Digital core power */
+};
+
+struct ov48b2q {
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct regmap *regmap;
+
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+
+	struct clk *mclk;
+	struct gpio_desc *reset;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(ov48b2q_supply_names)];
+};
+
+static inline struct ov48b2q *to_ov48b2q(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov48b2q, sd);
+}
+
+static int ov48b2q_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov48b2q *ov48b2q = container_of(ctrl->handler, struct ov48b2q, ctrl_handler);
+	s64 exposure_max;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		exposure_max = OV48B2Q_HEIGHT + ctrl->val - OV48B2Q_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(ov48b2q->exposure, ov48b2q->exposure->minimum,
+					 exposure_max, ov48b2q->exposure->step,
+					 min_t(s64, ov48b2q->exposure->val, exposure_max));
+	}
+
+	/* applied when the sensor is powered: enable_streams sets them all up */
+	if (!pm_runtime_get_if_in_use(ov48b2q->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(ov48b2q->regmap, OV48B2Q_REG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_EXPOSURE:
+		/* the vendor driver: "shutter must be even" */
+		cci_write(ov48b2q->regmap, OV48B2Q_REG_EXPOSURE, ctrl->val & ~1, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(ov48b2q->regmap, OV48B2Q_REG_VTS,
+			  (OV48B2Q_HEIGHT + ctrl->val) & ~1, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(ov48b2q->regmap, OV48B2Q_REG_TEST_PATTERN,
+			  ctrl->val ? 0x81 : 0x80, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(ov48b2q->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov48b2q_ctrl_ops = {
+	.s_ctrl = ov48b2q_set_ctrl,
+};
+
+static int ov48b2q_init_controls(struct ov48b2q *ov48b2q)
+{
+	struct v4l2_ctrl_handler *hdl = &ov48b2q->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 10);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, &ov48b2q_ctrl_ops, V4L2_CID_LINK_FREQ, 0, 0,
+				      ov48b2q_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &ov48b2q_ctrl_ops, V4L2_CID_PIXEL_RATE, OV48B2Q_PIXEL_RATE,
+			  OV48B2Q_PIXEL_RATE, 1, OV48B2Q_PIXEL_RATE);
+
+	ctrl = v4l2_ctrl_new_std(hdl, &ov48b2q_ctrl_ops, V4L2_CID_HBLANK,
+				 OV48B2Q_HTS - OV48B2Q_WIDTH, OV48B2Q_HTS - OV48B2Q_WIDTH, 1,
+				 OV48B2Q_HTS - OV48B2Q_WIDTH);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ov48b2q->vblank = v4l2_ctrl_new_std(hdl, &ov48b2q_ctrl_ops, V4L2_CID_VBLANK,
+					    OV48B2Q_VTS - OV48B2Q_HEIGHT,
+					    OV48B2Q_VTS_MAX - OV48B2Q_HEIGHT, 2,
+					    OV48B2Q_VTS - OV48B2Q_HEIGHT);
+
+	ov48b2q->exposure = v4l2_ctrl_new_std(hdl, &ov48b2q_ctrl_ops, V4L2_CID_EXPOSURE,
+					      OV48B2Q_EXPOSURE_MIN,
+					      OV48B2Q_VTS - OV48B2Q_EXPOSURE_MARGIN, 2,
+					      OV48B2Q_VTS - OV48B2Q_EXPOSURE_MARGIN);
+
+	v4l2_ctrl_new_std(hdl, &ov48b2q_ctrl_ops, V4L2_CID_ANALOGUE_GAIN, OV48B2Q_GAIN_MIN,
+			  OV48B2Q_GAIN_MAX, 1, OV48B2Q_GAIN_MIN);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &ov48b2q_ctrl_ops, V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(ov48b2q_test_pattern_menu) - 1, 0, 0,
+				     ov48b2q_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(ov48b2q->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &ov48b2q_ctrl_ops, &props);
+
+	if (hdl->error)
+		return hdl->error;
+
+	ov48b2q->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static void ov48b2q_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = OV48B2Q_WIDTH;
+	fmt->height = OV48B2Q_HEIGHT;
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+}
+
+static int ov48b2q_enable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct ov48b2q *ov48b2q = to_ov48b2q(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(ov48b2q->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_write(ov48b2q->regmap, OV48B2Q_REG_SW_RESET, 1, NULL);
+	if (ret)
+		goto out;
+	usleep_range(10000, 11000);
+
+	ret = regmap_multi_reg_write(ov48b2q->regmap, ov48b2q_init_regs,
+				     ARRAY_SIZE(ov48b2q_init_regs));
+	if (!ret)
+		ret = regmap_multi_reg_write(ov48b2q->regmap, ov48b2q_4000x3000_regs,
+					     ARRAY_SIZE(ov48b2q_4000x3000_regs));
+	if (ret) {
+		dev_err(ov48b2q->dev, "failed to write the mode: %d\n", ret);
+		goto out;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(ov48b2q->sd.ctrl_handler);
+	if (ret)
+		goto out;
+
+	ret = cci_write(ov48b2q->regmap, OV48B2Q_REG_STREAM, 1, NULL);
+out:
+	if (ret)
+		pm_runtime_put(ov48b2q->dev);
+
+	return ret;
+}
+
+static int ov48b2q_disable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				   u32 pad, u64 streams_mask)
+{
+	struct ov48b2q *ov48b2q = to_ov48b2q(sd);
+
+	cci_write(ov48b2q->regmap, OV48B2Q_REG_STREAM, 0, NULL);
+	pm_runtime_put(ov48b2q->dev);
+
+	return 0;
+}
+
+static int ov48b2q_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov48b2q *ov48b2q = to_ov48b2q(sd);
+
+	gpiod_set_value_cansleep(ov48b2q->reset, 1);
+	clk_disable_unprepare(ov48b2q->mclk);
+	regulator_bulk_disable(ARRAY_SIZE(ov48b2q->supplies), ov48b2q->supplies);
+
+	return 0;
+}
+
+static int ov48b2q_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov48b2q *ov48b2q = to_ov48b2q(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ov48b2q->supplies), ov48b2q->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(ov48b2q->mclk);
+	if (ret) {
+		dev_err(dev, "failed to enable the clock: %d\n", ret);
+		regulator_bulk_disable(ARRAY_SIZE(ov48b2q->supplies), ov48b2q->supplies);
+		return ret;
+	}
+
+	usleep_range(1000, 1100);
+	gpiod_set_value_cansleep(ov48b2q->reset, 0);
+	/* at least 8192 clocks before the first SCCB access */
+	usleep_range(5000, 5500);
+
+	return 0;
+}
+
+static int ov48b2q_set_format(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *fmt)
+{
+	ov48b2q_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, fmt->pad) = fmt->format;
+
+	return 0;
+}
+
+static int ov48b2q_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int ov48b2q_enum_frame_size(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index > 0 || fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = OV48B2Q_WIDTH;
+	fse->max_width = OV48B2Q_WIDTH;
+	fse->min_height = OV48B2Q_HEIGHT;
+	fse->max_height = OV48B2Q_HEIGHT;
+
+	return 0;
+}
+
+static int ov48b2q_get_selection(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		/* the binned output covers the whole 8000x6000 array */
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = 2 * OV48B2Q_WIDTH;
+		sel->r.height = 2 * OV48B2Q_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int ov48b2q_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	ov48b2q_fill_format(v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov48b2q_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov48b2q_pad_ops = {
+	.set_fmt = ov48b2q_set_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.enum_mbus_code = ov48b2q_enum_mbus_code,
+	.enum_frame_size = ov48b2q_enum_frame_size,
+	.get_selection = ov48b2q_get_selection,
+	.enable_streams = ov48b2q_enable_streams,
+	.disable_streams = ov48b2q_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov48b2q_subdev_ops = {
+	.video = &ov48b2q_video_ops,
+	.pad = &ov48b2q_pad_ops,
+};
+
+static const struct media_entity_operations ov48b2q_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static const struct v4l2_subdev_internal_ops ov48b2q_internal_ops = {
+	.init_state = ov48b2q_init_state,
+};
+
+static int ov48b2q_check_hwcfg(struct ov48b2q *ov48b2q)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct device *dev = ov48b2q->dev;
+	struct fwnode_handle *ep;
+	unsigned long bitmap;
+	int ret;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0, 0);
+	if (!ep)
+		return dev_err_probe(dev, -EPROBE_DEFER, "waiting for the endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(dev, ret, "parsing the endpoint failed\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != OV48B2Q_LANES) {
+		ret = dev_err_probe(dev, -EINVAL, "%u data lanes, only %u are supported\n",
+				    bus_cfg.bus.mipi_csi2.num_data_lanes, OV48B2Q_LANES);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies, ov48b2q_link_freqs,
+				       ARRAY_SIZE(ov48b2q_link_freqs), &bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static void ov48b2q_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov48b2q *ov48b2q = to_ov48b2q(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(ov48b2q->dev);
+	if (!pm_runtime_status_suspended(ov48b2q->dev)) {
+		ov48b2q_power_off(ov48b2q->dev);
+		pm_runtime_set_suspended(ov48b2q->dev);
+	}
+}
+
+static int ov48b2q_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov48b2q *ov48b2q;
+	u64 id;
+	int i, ret;
+
+	ov48b2q = devm_kzalloc(dev, sizeof(*ov48b2q), GFP_KERNEL);
+	if (!ov48b2q)
+		return -ENOMEM;
+	ov48b2q->dev = dev;
+
+	ov48b2q->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(ov48b2q->mclk))
+		return dev_err_probe(dev, PTR_ERR(ov48b2q->mclk), "no clock\n");
+	if (clk_get_rate(ov48b2q->mclk) != OV48B2Q_MCLK)
+		return dev_err_probe(dev, -EINVAL, "clock %lu Hz, not %u\n",
+				     clk_get_rate(ov48b2q->mclk), OV48B2Q_MCLK);
+
+	v4l2_i2c_subdev_init(&ov48b2q->sd, client, &ov48b2q_subdev_ops);
+
+	ret = ov48b2q_check_hwcfg(ov48b2q);
+	if (ret)
+		return ret;
+
+	ov48b2q->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ov48b2q->reset))
+		return dev_err_probe(dev, PTR_ERR(ov48b2q->reset), "no reset gpio\n");
+
+	for (i = 0; i < ARRAY_SIZE(ov48b2q_supply_names); i++)
+		ov48b2q->supplies[i].supply = ov48b2q_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ov48b2q->supplies), ov48b2q->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "no supplies\n");
+
+	ov48b2q->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(ov48b2q->regmap))
+		return PTR_ERR(ov48b2q->regmap);
+
+	ret = ov48b2q_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = cci_read(ov48b2q->regmap, OV48B2Q_REG_CHIP_ID, &id, NULL);
+	if (!ret && id != OV48B2Q_CHIP_ID) {
+		dev_err(dev, "chip id 0x%06llx, not 0x%06x\n", id, OV48B2Q_CHIP_ID);
+		ret = -ENXIO;
+	}
+	if (ret)
+		goto power_off;
+
+	ret = ov48b2q_init_controls(ov48b2q);
+	if (ret) {
+		dev_err(dev, "failed to init controls: %d\n", ret);
+		goto free_ctrls;
+	}
+
+	ov48b2q->sd.internal_ops = &ov48b2q_internal_ops;
+	ov48b2q->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	ov48b2q->sd.entity.ops = &ov48b2q_entity_ops;
+	ov48b2q->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov48b2q->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&ov48b2q->sd.entity, 1, &ov48b2q->pad);
+	if (ret)
+		goto free_ctrls;
+
+	ov48b2q->sd.state_lock = ov48b2q->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&ov48b2q->sd);
+	if (ret)
+		goto cleanup_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&ov48b2q->sd);
+	if (ret) {
+		dev_err(dev, "failed to register the subdev: %d\n", ret);
+		goto cleanup_subdev;
+	}
+
+	pm_runtime_idle(dev);
+
+	return 0;
+
+cleanup_subdev:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&ov48b2q->sd);
+cleanup_entity:
+	media_entity_cleanup(&ov48b2q->sd.entity);
+free_ctrls:
+	v4l2_ctrl_handler_free(&ov48b2q->ctrl_handler);
+power_off:
+	ov48b2q_power_off(dev);
+
+	return ret;
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(ov48b2q_pm_ops, ov48b2q_power_off, ov48b2q_power_on, NULL);
+
+static const struct of_device_id ov48b2q_of_match[] = {
+	{ .compatible = "ovti,ov48b2q" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ov48b2q_of_match);
+
+static struct i2c_driver ov48b2q_driver = {
+	.driver = {
+		.name = "ov48b2q",
+		.pm = pm_ptr(&ov48b2q_pm_ops),
+		.of_match_table = ov48b2q_of_match,
+	},
+	.probe = ov48b2q_probe,
+	.remove = ov48b2q_remove,
+};
+module_i2c_driver(ov48b2q_driver);
+
+MODULE_DESCRIPTION("OmniVision OV48B2Q sensor driver");
+MODULE_LICENSE("GPL");
