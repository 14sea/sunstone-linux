irqchip/qcom-mpm: optionally hold the XO except in system suspend

Once nothing on the APSS votes for the XO, the RPM shuts it down (vlow)
in runtime idle too, whenever the other subsystems sleep. On SM6375 the
UFS PHY does not keep the hibern8 link it rests in between requests
(runtime PM level 3 and auto-hibern8) through that: on sunstone (SM4375),
with USB unplugged and Wi-Fi power save on, the SoC entered vlow 404 times
in a few minutes, and every UFS request after one ended in a hibern8 exit
failure, aborts and host resets until I/O hung (55 errors, 15 resets).
System suspend is fine, as UFS turns the link off there (no PHY retention).

Take an optional "xo" clock and keep it prepared and enabled (an XO vote
in the RPM active and sleep sets) except between the late system suspend,
after the devices have suspended themselves, and the early resume. The
SoC then reaches XO shutdown and VDD min only in suspend.

Signed-off-by: 14sea <14sea@users.noreply.github.com>

diff --git a/drivers/irqchip/irq-qcom-mpm.c b/drivers/irqchip/irq-qcom-mpm.c
index 898a6da48..76ba231f9 100644
--- a/drivers/irqchip/irq-qcom-mpm.c
+++ b/drivers/irqchip/irq-qcom-mpm.c
@@ -4,6 +4,7 @@
  * Copyright (c) 2010-2020, The Linux Foundation. All rights reserved.
  */
 
+#include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/init.h>
@@ -82,6 +83,7 @@ struct mpm_gic_map {
 
 struct qcom_mpm_priv {
 	void __iomem *base;
+	struct clk *xo;
 	raw_spinlock_t lock;
 	struct mbox_client mbox_client;
 	struct mbox_chan *mbox_chan;
@@ -382,6 +384,16 @@ static int qcom_mpm_probe(struct platform_device *pdev, struct device_node *pare
 	if (!priv)
 		return -ENOMEM;
 
+	/*
+	 * An optional hold on the XO (in the RPM sleep set too), dropped only in system suspend: for
+	 * SoCs where devices lose state when the XO is shut down in runtime idle (the UFS PHY's
+	 * hibern8 link on SM6375), so that the SoC sleeps that deep only in suspend.
+	 */
+	priv->xo = devm_clk_get_optional_enabled(dev, "xo");
+	if (IS_ERR(priv->xo))
+		return dev_err_probe(dev, PTR_ERR(priv->xo), "failed to get xo clock\n");
+	platform_set_drvdata(pdev, priv);
+
 	ret = of_property_read_u32(np, "qcom,mpm-pin-count", &pin_cnt);
 	if (ret) {
 		dev_err(dev, "failed to read qcom,mpm-pin-count: %d\n", ret);
@@ -521,8 +533,29 @@ static int qcom_mpm_probe(struct platform_device *pdev, struct device_node *pare
 	return ret;
 }
 
+/* late: the devices have done their own suspend (UFS: link off) before the XO may go */
+static int qcom_mpm_suspend_late(struct device *dev)
+{
+	struct qcom_mpm_priv *priv = dev_get_drvdata(dev);
+
+	clk_disable_unprepare(priv->xo);
+
+	return 0;
+}
+
+static int qcom_mpm_resume_early(struct device *dev)
+{
+	struct qcom_mpm_priv *priv = dev_get_drvdata(dev);
+
+	return clk_prepare_enable(priv->xo);
+}
+
+static const struct dev_pm_ops qcom_mpm_pm_ops = {
+	SET_LATE_SYSTEM_SLEEP_PM_OPS(qcom_mpm_suspend_late, qcom_mpm_resume_early)
+};
+
 IRQCHIP_PLATFORM_DRIVER_BEGIN(qcom_mpm)
 IRQCHIP_MATCH("qcom,mpm", qcom_mpm_probe)
-IRQCHIP_PLATFORM_DRIVER_END(qcom_mpm)
+IRQCHIP_PLATFORM_DRIVER_END(qcom_mpm, .pm = &qcom_mpm_pm_ops)
 MODULE_DESCRIPTION("Qualcomm Technologies, Inc. MSM Power Manager");
 MODULE_LICENSE("GPL v2");
