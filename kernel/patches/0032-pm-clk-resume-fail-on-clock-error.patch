PM: clk: fail pm_clk_resume() when a clock does not enable

pm_clk_resume() logged a clock that failed to enable and returned 0, so
a runtime resume reported the device as running with its clocks off.
The LPASS RX/TX/VA macros keep their regmap cache-only when
pm_clk_resume() fails, but never saw the failure: on SM4375 (Xiaomi
Redmi Note 12 5G) the ADSP crashed during a resume from s2idle, the
macros' q6afe clock votes failed with it, and the regcache_sync() that
followed touched the unclocked macro registers; the bus hung and the
SoC reset.

Stop at the first clock that fails, switch the ones already enabled off
again and return the error. pm_clk_runtime_resume() and the drivers that
call pm_clk_resume() themselves already handle it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/drivers/base/power/clock_ops.c b/drivers/base/power/clock_ops.c
index 59bb37e82..e93d7ba8a 100644
--- a/drivers/base/power/clock_ops.c
+++ b/drivers/base/power/clock_ops.c
@@ -144,7 +144,7 @@ static void pm_clk_op_unlock(struct pm_subsys_data *psd, unsigned long *flags)
  * @dev: The device for the given clock
  * @ce: PM clock entry corresponding to the clock.
  */
-static inline void __pm_clk_enable(struct device *dev, struct pm_clock_entry *ce)
+static inline int __pm_clk_enable(struct device *dev, struct pm_clock_entry *ce)
 {
 	int ret;
 
@@ -156,13 +156,15 @@ static inline void __pm_clk_enable(struct device *dev, struct pm_clock_entry *ce
 		ret = clk_enable(ce->clk);
 		break;
 	default:
-		return;
+		return 0;
 	}
 	if (!ret)
 		ce->status = PCE_STATUS_ENABLED;
 	else
 		dev_err(dev, "%s: failed to enable clk %p, error %d\n",
 			__func__, ce->clk, ret);
+
+	return ret;
 }
 
 /**
@@ -521,12 +523,22 @@ int pm_clk_resume(struct device *dev)
 	if (ret)
 		return ret;
 
-	list_for_each_entry(ce, &psd->clock_list, node)
-		__pm_clk_enable(dev, ce);
+	list_for_each_entry(ce, &psd->clock_list, node) {
+		ret = __pm_clk_enable(dev, ce);
+		if (ret)
+			break;
+	}
 
 	pm_clk_op_unlock(psd, &flags);
 
-	return 0;
+	/*
+	 * Do not report a device whose clocks are not all running as
+	 * resumed: its driver would go on to touch its registers.
+	 */
+	if (ret)
+		pm_clk_suspend(dev);
+
+	return ret;
 }
 EXPORT_SYMBOL_GPL(pm_clk_resume);
 
