power: reset: reboot-mode: write a mode whose magic is 0

sunstone-linux local patch. The shim sets the PMIC PON reason to "bootloader" on every boot; a plain
reboot should clear it again (mode-normal = <0>), but reboot_mode_notify() skipped magic 0 because
get_reboot_mode_magic() also returns 0 for "no such mode" (boot-19: PON SOFT_RB_SPARE stayed 0x04).

--- a/drivers/power/reset/reboot-mode.c
+++ b/drivers/power/reset/reboot-mode.c
@@ -101,6 +101,20 @@
 	return 0;
 }
 
+/*
+ * sunstone: a mode can legitimately be 0 (e.g. "normal" clearing a reason the bootloader chain
+ * left in the PMIC), which get_reboot_mode_magic() cannot tell from "no such mode".
+ */
+static bool reboot_mode_defined(struct reboot_mode_driver *reboot, const char *cmd)
+{
+	struct mode_info *info;
+
+	list_for_each_entry(info, &reboot->head, list)
+		if (!strcmp(info->mode, cmd ? cmd : "normal"))
+			return true;
+	return false;
+}
+
 static int reboot_mode_notify(struct notifier_block *this,
 			      unsigned long mode, void *cmd)
 {
@@ -109,7 +123,7 @@
 
 	reboot = container_of(this, struct reboot_mode_driver, reboot_notifier);
 	magic = get_reboot_mode_magic(reboot, cmd);
-	if (magic)
+	if (magic || reboot_mode_defined(reboot, cmd))
 		reboot->write(reboot, magic);
 
 	return NOTIFY_DONE;
