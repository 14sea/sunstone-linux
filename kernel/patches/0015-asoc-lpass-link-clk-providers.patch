+#include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
 #include <linux/pm_runtime.h>
@@ -70,6 +71,32 @@ void lpass_macro_pds_exit(struct lpass_macro *pds)
 }
 EXPORT_SYMBOL_GPL(lpass_macro_pds_exit);
 
+/*
+ * Link the device to the providers of its clocks. The DSP's clock controller (q6afe, q6prm) is a
+ * subdevice of its remoteproc, created once the DSP is up, so fw_devlink ties the macros to the
+ * remoteproc instead, and that stays bound when the DSP restarts: the macros keep clocks whose
+ * provider is gone (clk_nodrv_ops) and touch their registers unclocked. With these links the
+ * clock controller going away unbinds them first; they can be probed again once it is back.
+ */
+void lpass_macro_link_clk_providers(struct device *dev)
+{
+	struct of_phandle_args args;
+	int i;
+
+	for (i = 0; !of_parse_phandle_with_args(dev->of_node, "clocks", "#clock-cells", i, &args);
+	     i++) {
+		struct platform_device *supplier = of_find_device_by_node(args.np);
+
+		of_node_put(args.np);
+		if (!supplier)
+			continue;
+		if (!device_link_add(dev, &supplier->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+			dev_warn(dev, "no device link to %s\n", dev_name(&supplier->dev));
+		put_device(&supplier->dev);
+	}
+}
+EXPORT_SYMBOL_GPL(lpass_macro_link_clk_providers);
+
 void lpass_macro_set_codec_version(enum lpass_codec_version version)
 {
 	guard(mutex)(&lpass_codec_mutex);
