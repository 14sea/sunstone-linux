ASoC: codecs: lpass-macro: link the macros to their clock providers

On SM4375 an ADSP restart takes the board down. The LPASS macros (and the
LPI pin controller) get their clocks from the DSP's clock controller
(q6afe), a subdevice of the ADSP's remoteproc that only exists while the
DSP is up. fw_devlink therefore links them to the remoteproc instead, and
the remoteproc stays bound across a restart: the clock controller goes,
the macros keep clocks with clk_nodrv_ops (pm_clk_suspend warns, enable
fails with -ENXIO), and when the sound card binds again after the restart
they touch their registers unclocked, which hangs the bus.

Link the macros and the LPI pin controller to the devices that actually
provide their clocks, with managed device links. When the clock controller
goes away with the DSP, the driver core now unbinds them (and with them the
SoundWire controllers and the sound card) first; they can be probed again
once it is back.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/drivers/pinctrl/qcom/pinctrl-lpass-lpi.c b/drivers/pinctrl/qcom/pinctrl-lpass-lpi.c
index 5fd4a4eba..929b5e6c1 100644
--- a/drivers/pinctrl/qcom/pinctrl-lpass-lpi.c
+++ b/drivers/pinctrl/qcom/pinctrl-lpass-lpi.c
@@ -9,6 +9,7 @@
 #include <linux/gpio/driver.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/seq_file.h>
 #include <linux/cleanup.h>
@@ -496,6 +497,29 @@ static int lpi_build_pin_desc_groups(struct lpi_pinctrl *pctrl)
 	return ret;
 }
 
+/*
+ * As lpass_macro_link_clk_providers(): the DSP's clock controller is a subdevice of its remoteproc,
+ * which fw_devlink links instead and which stays bound when the DSP restarts. Link the actual
+ * clock providers, so a restart unbinds the pin controller before its clocks go away.
+ */
+static void lpi_link_clk_providers(struct device *dev)
+{
+	struct of_phandle_args args;
+	int i;
+
+	for (i = 0; !of_parse_phandle_with_args(dev->of_node, "clocks", "#clock-cells", i, &args);
+	     i++) {
+		struct platform_device *supplier = of_find_device_by_node(args.np);
+
+		of_node_put(args.np);
+		if (!supplier)
+			continue;
+		if (!device_link_add(dev, &supplier->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+			dev_warn(dev, "no device link to %s\n", dev_name(&supplier->dev));
+		put_device(&supplier->dev);
+	}
+}
+
 int lpi_pinctrl_probe(struct platform_device *pdev)
 {
 	const struct lpi_pinctrl_variant_data *data;
@@ -538,6 +562,7 @@ int lpi_pinctrl_probe(struct platform_device *pdev)
 	ret = of_pm_clk_add_clks(dev);
 	if (ret < 0 && ret != -ENODEV)
 		return ret;
+	lpi_link_clk_providers(dev);
 
 	pm_runtime_set_autosuspend_delay(dev, 100);
 	pm_runtime_use_autosuspend(dev);
diff --git a/sound/soc/codecs/lpass-macro-common.c b/sound/soc/codecs/lpass-macro-common.c
