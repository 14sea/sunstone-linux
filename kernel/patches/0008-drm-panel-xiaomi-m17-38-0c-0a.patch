drm/panel: add the Xiaomi m17 38 0c 0a DSC panel (sunstone)

sunstone-linux local patch. Generated with linux-mdss-dsi-panel-driver-generator from the downstream
qcom,mdss_dsi_m17_38_0c_0a_fhdp_dsc_vid node, plus supplies, an off sequence, two DSC slices per
packet and a moderate initial brightness. DSC is set up the DDIC's way (9D 01, then the PPS through
9E) with slice height 40: the downstream PPS table says 40, its slice-height property says 20.

--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1352,6 +1352,17 @@
 	  Say Y here if you want to enable support for the Visionox
 	  G2647FB105 (2340x1080@60Hz) AMOLED DSI cmd mode panel.
 
+config DRM_PANEL_XIAOMI_M17_38_0C_0A
+	tristate "Xiaomi m17 38 0c 0a DSC video mode panel (sunstone)"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	select DRM_DISPLAY_HELPER
+	help
+	  Say Y here to enable support for the 1080x2400 AMOLED panel of the
+	  Xiaomi Redmi Note 12 5G (sunstone), driven in video mode with DSC.
+
 config DRM_PANEL_VISIONOX_R66451
 	tristate "Visionox R66451"
 	depends on OF
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -135,5 +135,6 @@
 obj-$(CONFIG_DRM_PANEL_VISIONOX_RM692E5) += panel-visionox-rm692e5.o
 obj-$(CONFIG_DRM_PANEL_VISIONOX_VTDR6130) += panel-visionox-vtdr6130.o
 obj-$(CONFIG_DRM_PANEL_VISIONOX_R66451) += panel-visionox-r66451.o
+obj-$(CONFIG_DRM_PANEL_XIAOMI_M17_38_0C_0A) += panel-xiaomi-m17-38-0c-0a.o
 obj-$(CONFIG_DRM_PANEL_WIDECHIPS_WS2401) += panel-widechips-ws2401.o
 obj-$(CONFIG_DRM_PANEL_XINPENG_XPP055C272) += panel-xinpeng-xpp055c272.o
--- a/drivers/gpu/drm/panel/panel-xiaomi-m17-38-0c-0a.c
+++ b/drivers/gpu/drm/panel/panel-xiaomi-m17-38-0c-0a.c
@@ -0,0 +1,385 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Xiaomi Redmi Note 12 5G (sunstone) "m17 38 0c 0a" 1080x2400 AMOLED panel, video mode, DSC 1.1.
+ *
+ * Generated with linux-mdss-dsi-panel-driver-generator from the downstream device tree
+ * (qcom,mdss_dsi_m17_38_0c_0a_fhdp_dsc_vid), then: supplies (vddio, avdd), an off sequence
+ * (downstream has none), two DSC slices per packet (qcom,mdss-dsc-slice-per-pkt = 2), the PPS
+ * computed by the host instead of the fixed one and a moderate initial brightness. The command set (F0/F1 5A 5A test keys) is a Samsung DDIC's.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+static const struct regulator_bulk_data m17_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "avdd" },
+};
+
+struct m17_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *reset_gpio;
+};
+
+static inline struct m17_panel *to_m17_panel(struct drm_panel *panel)
+{
+	return container_of_const(panel, struct m17_panel, panel);
+}
+
+static void m17_reset(struct m17_panel *ctx)
+{
+	/* downstream qcom,mdss-dsi-reset-sequence = <0 10 1 10> (raw levels, active low) */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+/*
+ * The downstream on-sequence sets DSC up with the DDIC's own commands: 9D 01 (compression on) and
+ * 9E with the first 89 bytes of the PPS, a fixed table for slice height 40. This sends the PPS the
+ * host computed (the DPU encodes with it) and warns if it no longer matches that table.
+ */
+static const u8 m17_downstream_pps[89] = {
+	0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x09, 0x60, 0x04, 0x38, 0x00, 0x28,
+	0x02, 0x1c, 0x02, 0x1c, 0x02, 0x00, 0x02, 0x0e, 0x00, 0x20, 0x03, 0xdd,
+	0x00, 0x07, 0x00, 0x0c, 0x02, 0x77, 0x02, 0x8b, 0x18, 0x00, 0x10, 0xf0,
+	0x03, 0x0c, 0x20, 0x00, 0x06, 0x0b, 0x0b, 0x33, 0x0e, 0x1c, 0x2a, 0x38,
+	0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b, 0x7d, 0x7e, 0x01, 0x02,
+	0x01, 0x00, 0x09, 0x40, 0x09, 0xbe, 0x19, 0xfc, 0x19, 0xfa, 0x19, 0xf8,
+	0x1a, 0x38, 0x1a, 0x78, 0x1a, 0xb6, 0x2a, 0xf6, 0x2b, 0x34, 0x2b, 0x74,
+	0x3b, 0x74, 0x6b, 0xf4, 0x00,
+};
+
+static void m17_write_pps(struct m17_panel *ctx, struct mipi_dsi_multi_context *dsi_ctx)
+{
+	struct drm_dsc_picture_parameter_set pps;
+	u8 buf[1 + sizeof(m17_downstream_pps)];
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	buf[0] = 0x9e;
+	memcpy(buf + 1, &pps, sizeof(m17_downstream_pps));
+	if (memcmp(buf + 1, m17_downstream_pps, sizeof(m17_downstream_pps)))
+		dev_warn(&ctx->dsi->dev, "PPS differs from the downstream table: %*ph %*ph\n",
+			 64, buf + 1, (int)sizeof(m17_downstream_pps) - 64, buf + 1 + 64);
+
+	mipi_dsi_dcs_write_buffer_multi(dsi_ctx, buf, sizeof(buf));
+}
+
+static int m17_on(struct m17_panel *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf1, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd0, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x25, 0xf2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x50);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x2f, 0xf2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x27);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf1, 0xa5, 0xa5);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb2, 0x01, 0x31);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xdf, 0x09, 0x30, 0x95, 0x43, 0xa9, 0x43, 0xa9);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9d, 0x01);
+	m17_write_pps(ctx, &dsi_ctx);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x0b);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x40, 0xf2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x03);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x15, 0xf6);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf6, 0xf0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x28, 0xf6);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf6, 0xf0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x3b, 0xf6);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf6, 0xf0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x0a, 0xf4);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf4, 0x98);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x11, 0xf4);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf4, 0xee);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x18, 0xb2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb2, 0x1c);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x11, 0xfe);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfe, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x0d, 0xb2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb2, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x0c, 0xb2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb2, 0x30);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x0b);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xed, 0x01, 0xcd, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe1, 0x93);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x06, 0xf4);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf4, 0x1f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x28);
+	mipi_dsi_dcs_set_display_brightness_multi(&dsi_ctx, 0x0000);
+	mipi_dsi_msleep(&dsi_ctx, 100);
+	/* display on (0x29) is in .enable */
+
+	return dsi_ctx.accum_err;
+}
+
+static int m17_off(struct m17_panel *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* not in the downstream DT: the standard DCS sequence (display off is in .disable) */
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int m17_prepare(struct drm_panel *panel)
+{
+	struct m17_panel *ctx = to_m17_panel(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(m17_supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+	/* downstream qcom,supply-post-on-sleep = 20 ms on vddio */
+	msleep(20);
+
+	m17_reset(ctx);
+
+	ret = m17_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		goto err;
+	}
+
+	return 0;
+
+err:
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(m17_supplies), ctx->supplies);
+	return ret;
+}
+
+static int m17_unprepare(struct drm_panel *panel)
+{
+	struct m17_panel *ctx = to_m17_panel(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = m17_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(m17_supplies), ctx->supplies);
+
+	return 0;
+}
+
+static int m17_enable(struct drm_panel *panel)
+{
+	struct m17_panel *ctx = to_m17_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int m17_disable(struct drm_panel *panel)
+{
+	struct m17_panel *ctx = to_m17_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	return dsi_ctx.accum_err;
+}
+
+static const struct drm_display_mode m17_mode = {
+	.clock = (1080 + 120 + 28 + 120) * (2400 + 20 + 2 + 10) * 120 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 120,
+	.hsync_end = 1080 + 120 + 28,
+	.htotal = 1080 + 120 + 28 + 120,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 20,
+	.vsync_end = 2400 + 20 + 2,
+	.vtotal = 2400 + 20 + 2 + 10,
+	.width_mm = 70,
+	.height_mm = 155,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int m17_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &m17_mode);
+}
+
+static const struct drm_panel_funcs m17_panel_funcs = {
+	.prepare = m17_prepare,
+	.enable = m17_enable,
+	.disable = m17_disable,
+	.unprepare = m17_unprepare,
+	.get_modes = m17_get_modes,
+};
+
+static int m17_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+static int m17_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return brightness;
+}
+
+static const struct backlight_ops m17_bl_ops = {
+	.update_status = m17_bl_update_status,
+	.get_brightness = m17_bl_get_brightness,
+};
+
+static struct backlight_device *m17_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	/* downstream qcom,mdss-dsi-bl-max-level = 2047; start at half */
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 1024,
+		.max_brightness = 2047,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &m17_bl_ops, &props);
+}
+
+static int m17_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct m17_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct m17_panel, panel, &m17_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(m17_supplies), m17_supplies,
+					    &ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/* both DSC slices of a line in one packet (downstream slice-per-pkt = 2) */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM |
+			  MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = m17_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	ret = devm_drm_panel_add(dev, &ctx->panel);
+	if (ret)
+		return ret;
+
+	/* the panel only takes DSC */
+	dsi->dsc = &ctx->dsc;
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	/* downstream qcom,mdss-dsc-slice-height says 20, the PPS it sends says 40 */
+	ctx->dsc.slice_height = 40;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+
+	return devm_mipi_dsi_attach(dev, dsi);
+}
+
+static const struct of_device_id m17_of_match[] = {
+	{ .compatible = "xiaomi,m17-38-0c-0a" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, m17_of_match);
+
+static struct mipi_dsi_driver m17_driver = {
+	.probe = m17_probe,
+	.driver = {
+		.name = "panel-xiaomi-m17-38-0c-0a",
+		.of_match_table = m17_of_match,
+	},
+};
+module_mipi_dsi_driver(m17_driver);
+
+MODULE_DESCRIPTION("DRM driver for the Xiaomi m17 38 0c 0a DSC video mode AMOLED panel (sunstone)");
+MODULE_LICENSE("GPL");
