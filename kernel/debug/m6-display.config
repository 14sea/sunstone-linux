# Debug fragment for the M6 built-in panel investigation (EXTRA_CONFIG=kernel/debug/m6-display.config):
# deferred fbcon takeover built in (fbcon=nodefer on the command line turns it off again, so one
# Image covers both) and a console font that is readable on a photo of the 1080x2400 panel.
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
# a USB network gadget without userspace (g_ncm, bound by the kernel as soon as the UDC is there) for
# netconsole during kernel init, and hung-task reports (20 s) that netconsole can carry
CONFIG_USB_G_NCM=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=20
CONFIG_SOFTLOCKUP_DETECTOR=y
