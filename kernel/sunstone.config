# sunstone-linux kernel config fragment, merged on top of arm64 defconfig (tools/build-kernel.sh)
CONFIG_LOCALVERSION="-sunstone"
CONFIG_RANDOMIZE_BASE=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# ABL's splash framebuffer (simple-framebuffer node) as the console
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# ramoops at 0xd0000000, readable from the downstream recovery after a warm reset
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_MAGIC_SYSRQ=y
# M2: dwc3 as a USB peripheral with a configfs NCM + ACM gadget (no modules in the initramfs)
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
# EPSS L3 provider: cpufreq-hw waits for it, without it CPUs stay at the shim's max clocks
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
# M3: UFS (ufshc@4804000 + the QMP v4 PHY, kernel/patches/0001)
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
# pacman 7 sandboxes its downloads with Landlock
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"
# M4: PMIC power-on (power/volume keys, reboot reasons), RTC, temperature alarm, ADC
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_SPMI_ADC5=y
# M4: touch (FT5452 on the GSI-only QUP SE i2c8, GPI DMA)
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
# M4: battery (SM5602 gauge, local patch 0003) and the SC8989X charger (BQ25890 register map)
CONFIG_BATTERY_SM5602=y
CONFIG_CHARGER_BQ25890=y
# M5: modem (PAS), QRTR, PD mapper, rmtfs memory, WCN3988 Wi-Fi (ath10k snoc); built in, the rootfs
# had no kernel modules when this was set up
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
# cfg80211 is built in and asks for regulatory.db before the root is mounted: build it into the image
# (tools/fetch-firmware.sh -> downloads/firmware, EXTRA_FIRMWARE_DIR set by build-kernel.sh).
# Not the GPU's SQE microcode, although msm asks for it when it binds (and logs an error then): with
# it built in, msm goes on to the zap shader, which is phone-specific and only on the root, and logs
# "gpu hw init failed" as well (boot-120). Both load from the root on the GPU's first use.
CONFIG_EXTRA_FIRMWARE="regulatory.db regulatory.db.p7s"
# M6: Adreno 619 (GMU wrapper) through the msm DRM driver; until the DPU/DSI display is up it runs
# as a render-only device next to simpledrm (msm.separate_gpu_kms=1 on the command line)
CONFIG_DRM_MSM=y
CONFIG_SM_GPUCC_6375=y
# DRM_MSM can only be built in if none of its optional Qualcomm dependencies are modules
CONFIG_QCOM_OCMEM=n
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_AOSS_QMP=y
# kernel log over the USB network to the test host (set up by the initramfs)
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
# M6 display: dispcc, the panel (local patch 0008), refgen for the DSI controller
CONFIG_SM_DISPCC_6375=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# the panel is built in again: with the MDSS reset in the DTS (resets = <&dispcc DISP_CC_MDSS_CORE_BCR>)
# its probe-time attach no longer meets ABL's live splash scanout (LOG.md boot-34-75)
CONFIG_DRM_PANEL_XIAOMI_M17_38_0C_0A=y
CONFIG_REGULATOR_QCOM_REFGEN=y
# server: the APSS watchdog (DT watchdog@f410000), petted by systemd (RuntimeWatchdogSec)
CONFIG_QCOM_WDT=y

# Ubuntu Server (and any general-purpose server userspace): what is needed before modules can load
# is built in, the rest stays as defconfig's modules, which build-kernel.sh now builds and installs
# (out/modules-STAGE, tools/push-modules.sh). AppArmor is Ubuntu's LSM (snapd's confinement uses
# it), PSI is for systemd-oomd, snaps are xz/lzo squashfs, ufw and iptables use the nft backend.
# Ubuntu's linux-firmware ships zstd-compressed files
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"
CONFIG_PSI=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZO=y
# snaps with xattrs mount without it, but with an error line each (xattrs ignored)
CONFIG_SQUASHFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_WIREGUARD=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
CONFIG_DUMMY=m
CONFIG_CIFS=m
CONFIG_ISO9660_FS=m
CONFIG_DM_CRYPT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_NAT=m
# the legacy tables (iptables-legacy, NETFILTER_XTABLES_LEGACY) stay off: Ubuntu's iptables and ufw
# use the nft backend, which needs nft_compat and the xt matches and targets below. The REJECT
# targets work with nft_compat too (taken out with the legacy tables once: ufw then failed, 2026-10-25)
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
# the vendor partition (EROFS, in super): sunstone-fw-install reads the GPU zap shader from it
CONFIG_EROFS_FS=m
# Bluetooth (WCN3988 on a GENI UART, hci_uart's QCA protocol): LE for HID-over-GATT keyboards and
# mice, which bluez serves through uhid; RFCOMM, BNEP and uinput as the usual bluez companions
CONFIG_BT_LE=y
CONFIG_UHID=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_INPUT_UINPUT=m
# BPF LSM, for systemd's RestrictFileSystems= (and other BPF security programs): the hooks need BTF
# (from full DWARF, so not DEBUG_INFO_REDUCED) and BPF_EVENTS, which needs kprobe/uprobe events and
# so ftrace; arm64's BPF trampolines attach at the function-entry NOPs that dynamic ftrace patches
CONFIG_BPF_LSM=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
# the vibration motor (gpio-vibrator) and the IR LED on SPI (ir-spi, sent through /dev/lirc0)
CONFIG_INPUT_GPIO_VIBRA=m
CONFIG_IR_SPI=m
CONFIG_LIRC=y
# the SIA8159 speaker amplifier (local patch 0012), on the WCD9370's AUX output
CONFIG_SND_SOC_SIA8159=m
# cameras: the WL2866D camera LDOs (local patch 0017), CAMSS (0018), the 8 MP OV08D10 (0019), the
# 48 MP OV48B2Q (0020, 0022) and its DW9800 AF actuator, the 2 MP SC202CS (0021)
CONFIG_REGULATOR_WL2866D=m
CONFIG_VIDEO_OV08D10=m
CONFIG_VIDEO_OV48B2Q=m
CONFIG_VIDEO_DW9719=m
CONFIG_VIDEO_SC202CS=m
# libcamera's software ISP allocates its frame buffers from a dma-buf heap (the system heap: see
# rootfs-overlay's 70-sunstone-dma-heap.rules); built in, as modules nothing loads them
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
