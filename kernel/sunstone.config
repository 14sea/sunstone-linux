# sunstone-linux kernel config fragment, merged on top of arm64 defconfig (tools/build-kernel.sh)
CONFIG_LOCALVERSION="-sunstone"
CONFIG_RANDOMIZE_BASE=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# ABL's splash framebuffer (simple-framebuffer node) as the console
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# ramoops at 0xd0000000, readable from the downstream recovery after a warm reset
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_MAGIC_SYSRQ=y
