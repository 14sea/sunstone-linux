# sunstone-linux kernel config fragment, merged on top of arm64 defconfig (tools/build-kernel.sh)
CONFIG_LOCALVERSION="-sunstone"
CONFIG_RANDOMIZE_BASE=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# ABL's splash framebuffer (simple-framebuffer node) as the console
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# ramoops at 0xd0000000, readable from the downstream recovery after a warm reset
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_MAGIC_SYSRQ=y
# M2: dwc3 as a USB peripheral with a configfs NCM + ACM gadget (no modules in the initramfs)
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
# EPSS L3 provider: cpufreq-hw waits for it, without it CPUs stay at the shim's max clocks
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
# M3: UFS (ufshc@4804000 + the QMP v4 PHY, kernel/patches/0001)
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
# pacman 7 sandboxes its downloads with Landlock
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"
# M4: PMIC power-on (power/volume keys, reboot reasons), RTC, temperature alarm, ADC
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_SPMI_ADC5=y
# M4: touch (FT5452 on the GSI-only QUP SE i2c8, GPI DMA)
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
# M4: battery (SM5602 gauge, local patch 0003) and the SC8989X charger (BQ25890 register map)
CONFIG_BATTERY_SM5602=y
CONFIG_CHARGER_BQ25890=y
