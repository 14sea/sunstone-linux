+/*
+ * A mapped directory that allows writing: its files can be created, written
+ * and removed, and its subdirectories allow the same. Writes stay inside it:
+ * the segments never contain '/', ".." is handled by hexagonfs_openat() above
+ * the physical directories, and new files are not opened through symlinks.
+ */
+static int mapped_rw_openat(struct hexagonfs_fd *dir,
+			    const char *segment,
+			    bool expect_dir,
+			    struct hexagonfs_fd **out)
+{
+	int ret;
+
+	ret = mapped_openat(dir, segment, expect_dir, out);
+	if (ret)
+		return ret;
+
+	(*out)->ops = &hexagonfs_mapped_rw_ops;
+
+	return 0;
+}
+
+static int mapped_rw_create(struct hexagonfs_fd *dir,
+			    const char *segment,
+			    int flags,
+			    struct hexagonfs_fd **out)
+{
+	struct mapped_ctx *dir_ctx = dir->data;
+	struct hexagonfs_fd *fd;
+	struct mapped_ctx *ctx;
+	struct stat phys;
+	int ret;
+
+	ctx = malloc(sizeof(struct mapped_ctx));
+	if (ctx == NULL)
+		return -ENOMEM;
+
+	fd = malloc(sizeof(struct hexagonfs_fd));
+	if (fd == NULL) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	flags &= O_ACCMODE | O_CREAT | O_TRUNC | O_APPEND;
+	ctx->fd = openat(dir_ctx->fd, segment, flags | O_NOFOLLOW | O_CLOEXEC, 0644);
+	if (ctx->fd == -1) {
+		ret = -errno;
+		goto err_free_fd;
+	}
+
+	if (fstat(ctx->fd, &phys) || !S_ISREG(phys.st_mode)) {
+		close(ctx->fd);
+		ret = -EINVAL;
+		goto err_free_fd;
+	}
+
+	ctx->dir = NULL;
+
+	fd->is_assigned = false;
+	fd->up = dir;
+	fd->ops = &hexagonfs_mapped_rw_ops;
+	fd->data = ctx;
+
+	*out = fd;
+
+	return 0;
+
+err_free_fd:
+	free(fd);
+err:
+	free(ctx);
+	return ret;
+}
+
+static int mapped_rw_unlink(struct hexagonfs_fd *dir, const char *segment)
+{
+	struct mapped_ctx *dir_ctx = dir->data;
+
+	if (unlinkat(dir_ctx->fd, segment, 0))
+		return -errno;
+
+	return 0;
+}
+
+static int mapped_rw_rename(struct hexagonfs_fd *dir, const char *segment,
+			    struct hexagonfs_fd *new_dir, const char *new_segment)
+{
+	struct mapped_ctx *dir_ctx = dir->data;
+	struct mapped_ctx *new_dir_ctx = new_dir->data;
+
+	if (renameat(dir_ctx->fd, segment, new_dir_ctx->fd, new_segment))
+		return -errno;
+
+	return 0;
+}
+
+static ssize_t mapped_write(struct hexagonfs_fd *fd, size_t size, const void *ptr)
+{
+	struct mapped_ctx *ctx = fd->data;
+	size_t done = 0;
+	ssize_t ret;
+
+	while (done < size) {
+		ret = write(ctx->fd, (const char *) ptr + done, size - done);
+		if (ret < 0)
+			return -errno;
+
+		done += ret;
+	}
+
+	return done;
+}
+
