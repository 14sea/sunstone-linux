+
+int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
+{
+	struct hexagonfs_fd *fd;
+	int ret;
+
+	ret = walk(fds, rootfd, dirfd, name, &fd);
+	if (ret)
+		return ret;
+
 	ret = allocate_file_number(fds, fd);
+	if (ret < 0)
+		destroy_file_descriptor(fd);
+
+	return ret;
+}
+
+/*
+ * Walk to the directory NAME is in and return its last segment, which must
+ * name a file in it (not "", "." or "..").
+ */
+static int walk_to_parent(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+			  const char *name, struct hexagonfs_fd **dir,
+			  const char **last)
+{
+	char *parent;
+	int ret;
+
+	*last = strrchr(name, '/');
+	*last = *last == NULL ? name : *last + 1;
+
+	if (**last == '\0' || !strcmp(*last, ".") || !strcmp(*last, ".."))
+		return -EISDIR;
+
+	parent = strndup(name, *last - name);
+	if (parent == NULL)
+		return -ENOMEM;
+
+	ret = walk(fds, rootfd, dirfd, parent, dir);
+	free(parent);
+
+	return ret;
+}
+
+/*
+ * Open a file for writing with open(2) FLAGS (O_WRONLY or O_RDWR, and any of
+ * O_CREAT, O_TRUNC and O_APPEND). Only directories with a create operation
+ * allow it, the others fail with EROFS.
+ */
+int hexagonfs_openat_write(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+			   const char *name, int flags)
+{
+	struct hexagonfs_fd *dir, *fd;
+	const char *last;
+	int ret;
+
+	ret = walk_to_parent(fds, rootfd, dirfd, name, &dir, &last);
 	if (ret)
+		return ret;
+
+	if (dir->ops->create == NULL) {
+		ret = -EROFS;
 		goto err;
+	}
+
+	ret = dir->ops->create(dir, last, flags, &fd);
+	if (ret)
+		goto err;
+
+	ret = allocate_file_number(fds, fd);
+	if (ret < 0)
+		destroy_file_descriptor(fd);
 
 	return ret;
 
 err:
-	destroy_file_descriptor(fd);
+	destroy_file_descriptor(dir);
+
+	return ret;
+}
+
+int hexagonfs_unlinkat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
+{
+	struct hexagonfs_fd *dir;
+	const char *last;
+	int ret;
+
+	ret = walk_to_parent(fds, rootfd, dirfd, name, &dir, &last);
+	if (ret)
+		return ret;
+
+	if (dir->ops->unlink == NULL)
+		ret = -EROFS;
+	else
