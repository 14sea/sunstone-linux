+/*
+ * Rename a file within the directories that allow writing (both directories
+ * must be of the same kind, otherwise this fails with EXDEV).
+ */
+int hexagonfs_renameat(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		       const char *name, const char *new_name)
+{
+	struct hexagonfs_fd *dir, *new_dir;
+	const char *last, *new_last;
+	int ret;
+
+	ret = walk_to_parent(fds, rootfd, dirfd, name, &dir, &last);
+	if (ret)
+		return ret;
+
+	ret = walk_to_parent(fds, rootfd, dirfd, new_name, &new_dir, &new_last);
+	if (ret)
+		goto err;
+
+	if (dir->ops->rename == NULL)
+		ret = -EROFS;
+	else if (new_dir->ops != dir->ops)
+		ret = -EXDEV;
+	else
+		ret = dir->ops->rename(dir, last, new_dir, new_last);
+
+	destroy_file_descriptor(new_dir);
+err:
+	destroy_file_descriptor(dir);
+
+	return ret;
+}
+
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->write == NULL)
+		return -EBADF;
+
+	return fd->ops->write(fd, size, ptr);
+}
