 	stats_.sum_ = RGB<uint64_t>({ 0, 0, 0 });
 	stats_.yHistogram.fill(0);
+	stats_.sharpness = 0;
+	stats_.sharpnessLevel = 0;
+	stats_.sharpnessCount = 0;
+}
+
+/**
+ * \brief Accumulate the sharpness statistics of a line
+ * \param[in] y The y coordinate of the line
+ * \param[in] line The start of the line
+ *
+ * Sums the squared differences between pixels two apart (the same Bayer
+ * colour) inside the focus window, for contrast detection autofocus. Packed
+ * CSI-2 10-bit data uses the 8 most significant bits.
+ */
+void SwStatsCpu::statsSharpness(unsigned int y, const uint8_t *line)
+{
+	const Rectangle &w = sharpnessWindow_;
+
+	if (y < static_cast<unsigned int>(w.y) || y >= w.y + w.height)
+		return;
+
+	uint64_t sum = 0, level = 0;
+	unsigned int count = 0;
+
+	auto add = [&](int a, int b) {
+		int d = a - b;
+		sum += d * d;
+		level += a;
+		count++;
+	};
+
+	switch (sharpnessFormat_) {
+	case SharpnessFormat::Bytes: {
+		const uint8_t *p = line + w.x;
+		for (unsigned int x = 0; x + 2 < w.width; x++)
+			add(p[x], p[x + 2]);
+		break;
+	}
+	case SharpnessFormat::Words: {
+		const uint16_t *p = reinterpret_cast<const uint16_t *>(line) + w.x;
+		for (unsigned int x = 0; x + 2 < w.width; x++)
+			add(p[x], p[x + 2]);
+		break;
+	}
+	case SharpnessFormat::Csi2p: {
+		/* 4 pixels in 5 bytes, the first 4 bytes hold their MSBs */
+		const uint8_t *p = line + w.x * 5 / 4;
+		for (unsigned int x = 0; x + 4 < w.width; x += 4, p += 5) {
+			add(p[0], p[2]);
+			add(p[1], p[3]);
+			add(p[2], p[5]);
+			add(p[3], p[6]);
+		}
+		break;
+	}
+	case SharpnessFormat::None:
+		return;
+	}
+
+	stats_.sharpness += sum;
+	stats_.sharpnessLevel += level;
+	stats_.sharpnessCount += count;
 }
 
