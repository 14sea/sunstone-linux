diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 0000000..f0a1e23
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,289 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus for the software ISP
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include "control_ids.h"
+
+/**
+ * \file af.h
+ * \brief Contrast detection autofocus
+ *
+ * The focus measure is the software ISP's sharpness statistic (squared
+ * differences of same-colour neighbours in the centre ninth of the image),
+ * divided by the squared mean level there so that exposure and gain changes
+ * cancel out. A scan steps the lens through its range in coarse steps,
+ * stopping early once well past a peak, then around the best position in
+ * fine steps, and leaves the lens at the sharpest one. Each statistics
+ * sample (every SwStatsCpu::kStatPerNumFrames frames) measures the position
+ * set at the previous one.
+ *
+ * In continuous mode (the default, as applications through PipeWire set no
+ * focus controls) the scene is watched once focused: when the measure falls
+ * well below what it was after focusing for several samples in a row, the
+ * lens is scanned again. A change of brightness alone (AGC, lighting) only
+ * resets that reference.
+ *
+ * Tuning parameters (all optional):
+ * - rangeMin, rangeMax: lens positions to scan (default: the lens range)
+ * - coarseStep, fineStep: scan steps (48, 12)
+ * - defaultPosition: where to leave the lens when the scene has no contrast
+ *   (default: rangeMin)
+ * - minContrast: best / worst measure of a scan below which it failed (1.2)
+ * - rescanDrop, rescanSamples: rescan when the measure falls below rescanDrop
+ *   times the focused one for rescanSamples samples (0.6, 4)
+ * - rescanLevel: a level change of more than this fraction (0.3) for
+ *   rescanSamples samples, without a drop, resets the reference
+ */
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+int Af::init(IPAContext &context, const YamlObject &tuningData)
+{
+	rangeMin_ = tuningData["rangeMin"].get<int32_t>(-1);
+	rangeMax_ = tuningData["rangeMax"].get<int32_t>(-1);
+	coarseStep_ = std::max(tuningData["coarseStep"].get<int32_t>(48), 1);
+	fineStep_ = std::max(tuningData["fineStep"].get<int32_t>(12), 1);
+	defaultPosition_ = tuningData["defaultPosition"].get<int32_t>(-1);
+	minContrast_ = tuningData["minContrast"].get<double>(1.2);
+	rescanDrop_ = tuningData["rescanDrop"].get<double>(0.6);
+	rescanLevel_ = tuningData["rescanLevel"].get<double>(0.3);
+	rescanSamples_ = tuningData["rescanSamples"].get<uint32_t>(4);
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, ControlValue(controls::AfModeContinuous));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	const auto &lens = context.configuration.lens;
+
+	enabled_ = lens.present;
+	if (!enabled_) {
+		LOG(IPASoftAf, Info) << "No focus lens, autofocus off";
+		return 0;
+	}
+
+	min_ = rangeMin_ >= 0 ? std::clamp(rangeMin_, lens.min, lens.max) : lens.min;
+	max_ = rangeMax_ >= 0 ? std::clamp(rangeMax_, min_, lens.max) : lens.max;
+	if (defaultPosition_ < 0)
+		defaultPosition_ = min_;
+	defaultPosition_ = std::clamp(defaultPosition_, min_, max_);
+
+	mode_ = controls::AfModeContinuous;
+	phase_ = Phase::Idle;
+	failed_ = false;
+	haveBaseline_ = false;
+	if (mode_ == controls::AfModeContinuous)
+		startScan();
+
+	LOG(IPASoftAf, Info) << "Lens range " << min_ << "-" << max_;
+
+	return 0;
+}
+
+void Af::queueRequest([[maybe_unused]] IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!enabled_)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = static_cast<controls::AfModeEnum>(*mode);
+		LOG(IPASoftAf, Debug) << "AfMode " << *mode;
+		if (mode_ == controls::AfModeContinuous)
+			startScan();
+		else
+			phase_ = Phase::Idle;
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart)
+			startScan();
+		else if (*trigger == controls::AfTriggerCancel)
+			phase_ = Phase::Idle;
+	}
+}
+
+void Af::startScan()
+{
+	phase_ = Phase::Coarse;
+	failed_ = false;
+	haveBaseline_ = false;
+	/* the first sample(s) wait for AGC to settle, then move to the start */
+	wait_ = startSamples_;
+	position_ = -1;
+	bestMeasure_ = 0.0;
+	worstMeasure_ = 0.0;
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	position_ = std::clamp(position, min_, max_);
+	context.activeState.lens.position = position_;
+	context.activeState.lens.pending = true;
+}
+
+void Af::finishScan(IPAContext &context, int32_t position, bool found)
+{
+	moveTo(context, position);
+	phase_ = Phase::Focused;
+	failed_ = !found;
+	haveBaseline_ = false;
+	changed_ = 0;
+	/* the sample after the move is the new baseline */
+	wait_ = 0;
+
+	LOG(IPASoftAf, Info)
+		<< (found ? "Focused at " : "No contrast, lens at ") << position_
+		<< " (measure " << bestMeasure_ << ", worst " << worstMeasure_ << ")";
+}
+
+void Af::scanStep(IPAContext &context, double measure)
+{
+	LOG(IPASoftAf, Debug) << "Position " << position_ << " measure " << measure;
+
+	if (measure > bestMeasure_) {
+		bestMeasure_ = measure;
+		bestPosition_ = position_;
+	}
+	if (worstMeasure_ == 0.0 || measure < worstMeasure_)
+		worstMeasure_ = measure;
+
+	bool contrast = bestMeasure_ > worstMeasure_ * minContrast_;
+	/* well past a peak: the far side of it will not be sharper */
+	bool pastPeak = contrast && measure < bestMeasure_ * 0.5 &&
+			position_ >= bestPosition_ + 2 * step_;
+
+	if (position_ + step_ <= scanEnd_ && !pastPeak) {
+		moveTo(context, position_ + step_);
+		return;
+	}
+
+	if (phase_ == Phase::Coarse) {
+		if (!contrast) {
+			finishScan(context, defaultPosition_, false);
+			return;
+		}
+		phase_ = Phase::Fine;
+		step_ = fineStep_;
+		scanEnd_ = std::min(bestPosition_ + coarseStep_, max_);
+		moveTo(context, bestPosition_ - coarseStep_);
+		return;
+	}
+
+	finishScan(context, bestPosition_, true);
+}
+
+void Af::watch(double measure, double level)
+{
+	if (!haveBaseline_) {
+		haveBaseline_ = true;
+		baselineMeasure_ = measure;
+		baselineLevel_ = level;
+		return;
+	}
+
+	bool dropped = measure < baselineMeasure_ * rescanDrop_;
+	bool relit = std::abs(level - baselineLevel_) > baselineLevel_ * rescanLevel_;
+
+	if (!dropped && !relit) {
+		changed_ = 0;
+		/* follow slow changes */
+		baselineMeasure_ = 0.8 * baselineMeasure_ + 0.2 * measure;
+		return;
+	}
+
+	if (++changed_ < rescanSamples_)
+		return;
+
+	/*
+	 * Light alone (AGC still converging after the scan, a lamp switched
+	 * on) does not defocus: take the new state as the baseline.
+	 */
+	if (!dropped) {
+		LOG(IPASoftAf, Debug)
+			<< "Level " << level << " was " << baselineLevel_ << ", new baseline";
+		haveBaseline_ = false;
+		changed_ = 0;
+		return;
+	}
+
+	if (mode_ != controls::AfModeContinuous)
+		return;
+
+	LOG(IPASoftAf, Debug)
+		<< "Scene changed (measure " << measure << " was " << baselineMeasure_
+		<< ", level " << level << " was " << baselineLevel_ << "), rescanning";
+	startScan();
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!enabled_)
+		return;
+
+	int32_t state = controls::AfStateIdle;
+	if (phase_ == Phase::Coarse || phase_ == Phase::Fine)
+		state = controls::AfStateScanning;
+	else if (phase_ == Phase::Focused)
+		state = failed_ ? controls::AfStateFailed : controls::AfStateFocused;
+	metadata.set(controls::AfState, state);
+
+	if (!stats->valid || !stats->sharpnessCount || phase_ == Phase::Idle)
+		return;
+
+	double level = static_cast<double>(stats->sharpnessLevel) / stats->sharpnessCount;
+	if (level < 1.0)
+		return;
+	double measure = static_cast<double>(stats->sharpness) / stats->sharpnessCount /
+			 (level * level);
+
+	if (wait_) {
+		wait_--;
+		return;
+	}
+
+	if (phase_ == Phase::Focused) {
+		watch(measure, level);
+		return;
+	}
+
+	if (position_ < 0) {
+		/* start of a scan: the lens is not at a scan position yet */
+		step_ = coarseStep_;
+		scanEnd_ = max_;
+		moveTo(context, min_);
+		return;
+	}
+
+	scanStep(context, measure);
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
