+		CameraLens *lens = data->sensor_->focusLens();
+		if (lens) {
+			auto it = lens->controls().find(V4L2_CID_FOCUS_ABSOLUTE);
+			if (it != lens->controls().end()) {
+				configInfo.lensPresent = true;
+				configInfo.lensMin = it->second.min().get<int32_t>();
+				configInfo.lensMax = it->second.max().get<int32_t>();
+			}
+		}
 		return data->swIsp_->configure(inputCfg, outputCfgs, configInfo);
 	}
 }
