diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 0000000..d73dde5
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,405 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus for the software ISP
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include "control_ids.h"
+
+/**
+ * \file af.h
+ * \brief Contrast detection autofocus
+ *
+ * The focus measure is the software ISP's sharpness statistic (squared
+ * differences of same-colour neighbours in the centre ninth of the image),
+ * divided by the squared mean level there so that exposure and gain changes
+ * cancel out. Each statistics sample (every SwStatsCpu::kStatPerNumFrames
+ * frames) measures the lens position set at the previous one.
+ *
+ * A full scan steps the lens through its range in coarse steps, from the far
+ * end, stopping once well past a peak; a fine scan around the best position
+ * follows, and the lens goes to the peak of a parabola through the best fine
+ * sample and its neighbours, from below like the scans: the actuator (a voice
+ * coil) does not end up in the same place coming from above. A scan only starts on a still scene (two samples
+ * in a row with about the same level and measure) that is neither too dark
+ * nor saturated, and is abandoned when the level moves during it (the camera
+ * moved). After a scan, the first sample at the chosen position must be
+ * close to the best one of the scan, or the scene changed meanwhile and it is
+ * scanned again.
+ *
+ * In continuous mode (the default, as applications through PipeWire set no
+ * focus controls) the focused scene is watched: when the measure falls below
+ * rescanDrop of the focused one, or the level changes by more than
+ * rescanLevel, for rescanSamples samples, the lens is checked again as soon
+ * as the scene is still. A brightness change alone only gets a fine scan
+ * around the current position; when its best sample is at either end of it,
+ * or the measure had dropped, a full scan follows.
+ *
+ * With the global configuration option software_isp.focus (environment
+ * variable LIBCAMERA_SOFTISP_FOCUS) set to "fixed", the lens is held at
+ * fixedPosition instead, like a fixed focus camera focused at its
+ * hyperfocal distance.
+ *
+ * Tuning parameters (all optional):
+ * - rangeMin, rangeMax: lens positions to scan (default: the lens range)
+ * - coarseStep, fineStep: scan steps (48, 16)
+ * - fixedPosition: the position for the fixed focus, and where the lens goes
+ *   when a scan finds no contrast (default: rangeMin)
+ * - minContrast, minMeasure: a scan whose best / worst measure is below
+ *   minContrast, or whose best measure is below minMeasure, failed (1.5,
+ *   1e-3)
+ * - rescanDrop, rescanLevel, rescanSamples: see above (0.6, 0.3, 3)
+ */
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace {
+
+/* mean levels (8 bit) between which a scan can find focus */
+constexpr double kMinLevel = 12.0;
+constexpr double kMaxLevel = 210.0;
+/* level and measure changes still taken as the same scene */
+constexpr double kStillLevel = 0.08;
+constexpr double kStillMeasure = 0.25;
+/* level change during a scan that abandons it */
+constexpr double kScanLevel = 0.15;
+/* the measure after a scan must reach this fraction of the scan's best */
+constexpr double kVerify = 0.7;
+
+} /* namespace */
+
+int Af::init(IPAContext &context, const YamlObject &tuningData)
+{
+	rangeMin_ = tuningData["rangeMin"].get<int32_t>(-1);
+	rangeMax_ = tuningData["rangeMax"].get<int32_t>(-1);
+	coarseStep_ = std::max(tuningData["coarseStep"].get<int32_t>(48), 1);
+	fineStep_ = std::max(tuningData["fineStep"].get<int32_t>(16), 1);
+	fixedPosition_ = tuningData["fixedPosition"].get<int32_t>(-1);
+	minContrast_ = tuningData["minContrast"].get<double>(1.5);
+	minMeasure_ = tuningData["minMeasure"].get<double>(1e-3);
+	rescanDrop_ = tuningData["rescanDrop"].get<double>(0.6);
+	rescanLevel_ = tuningData["rescanLevel"].get<double>(0.3);
+	rescanSamples_ = tuningData["rescanSamples"].get<uint32_t>(3);
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, ControlValue(controls::AfModeContinuous));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	const auto &lens = context.configuration.lens;
+
+	enabled_ = lens.present;
+	if (!enabled_) {
+		LOG(IPASoftAf, Info) << "No focus lens, autofocus off";
+		return 0;
+	}
+
+	min_ = rangeMin_ >= 0 ? std::clamp(rangeMin_, lens.min, lens.max) : lens.min;
+	max_ = rangeMax_ >= 0 ? std::clamp(rangeMax_, min_, lens.max) : lens.max;
+	if (fixedPosition_ < 0)
+		fixedPosition_ = min_;
+	fixedPosition_ = std::clamp(fixedPosition_, min_, max_);
+
+	fixed_ = configInfo.fixedFocus;
+	mode_ = fixed_ ? controls::AfModeManual : controls::AfModeContinuous;
+	failed_ = false;
+	verifyFailures_ = 0;
+	position_ = -1;
+	if (fixed_) {
+		phase_ = Phase::Idle;
+		moveTo(context, fixedPosition_);
+	} else {
+		wait(true);
+	}
+
+	LOG(IPASoftAf, Info)
+		<< "Lens range " << min_ << "-" << max_ << ", "
+		<< (fixed_ ? "fixed focus at " : "autofocus, no contrast: ")
+		<< fixedPosition_;
+
+	return 0;
+}
+
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!enabled_)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = static_cast<controls::AfModeEnum>(*mode);
+		LOG(IPASoftAf, Debug) << "AfMode " << *mode;
+		if (mode_ == controls::AfModeContinuous) {
+			wait(true);
+		} else {
+			phase_ = Phase::Idle;
+			if (fixed_)
+				moveTo(context, fixedPosition_);
+		}
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart)
+			wait(true);
+		else if (*trigger == controls::AfTriggerCancel)
+			phase_ = Phase::Idle;
+	}
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	position_ = std::clamp(position, min_, max_);
+	context.activeState.lens.position = position_;
+	context.activeState.lens.pending = true;
+}
+
+void Af::wait(bool full)
+{
+	phase_ = Phase::Wait;
+	fullScan_ = full;
+	stable_ = 0;
+	lastMeasure_ = 0.0;
+	lastLevel_ = 0.0;
+}
+
+void Af::startScan(IPAContext &context, bool full, double level)
+{
+	failed_ = false;
+	scanLevel_ = level;
+	samples_.clear();
+	bestMeasure_ = 0.0;
+	worstMeasure_ = 0.0;
+
+	if (!full && position_ >= 0) {
+		startFine(context, position_, 2 * fineStep_);
+		return;
+	}
+
+	phase_ = Phase::Coarse;
+	step_ = coarseStep_;
+	scanEnd_ = max_;
+	moveTo(context, min_);
+}
+
+void Af::startFine(IPAContext &context, int32_t centre, int32_t halfWidth)
+{
+	phase_ = Phase::Fine;
+	step_ = fineStep_;
+	samples_.clear();
+	scanEnd_ = std::min(centre + halfWidth, max_);
+	moveTo(context, centre - halfWidth);
+}
+
+void Af::finish(IPAContext &context, int32_t position, bool found)
+{
+	target_ = std::clamp(position, min_, max_);
+	approach_ = found && target_ < position_ && target_ - fineStep_ >= min_;
+	moveTo(context, approach_ ? target_ - fineStep_ : target_);
+	failed_ = !found;
+	changed_ = 0;
+	phase_ = found ? Phase::Verify : Phase::Focused;
+	baselineMeasure_ = 0.0;
+
+	LOG(IPASoftAf, Info)
+		<< (found ? "Focused at " : "No contrast, lens at ") << target_
+		<< " (measure " << bestMeasure_ << ", worst " << worstMeasure_ << ")";
+}
+
+/* the peak of the parabola through the best fine sample and its neighbours */
+int32_t Af::peak() const
+{
+	auto best = std::max_element(samples_.begin(), samples_.end(),
+				     [](const auto &a, const auto &b) { return a.second < b.second; });
+	if (best == samples_.begin() || best + 1 == samples_.end())
+		return best->first;
+
+	double l = (best - 1)->second, c = best->second, r = (best + 1)->second;
+	double d = l - 2 * c + r;
+	if (d >= 0.0)
+		return best->first;
+
+	double offset = std::clamp(0.5 * (l - r) / d, -0.5, 0.5);
+	return best->first + std::lround(offset * step_);
+}
+
+void Af::scanStep(IPAContext &context, double measure, double level)
+{
+	LOG(IPASoftAf, Debug) << "Position " << position_ << " measure " << measure
+			      << " level " << level;
+
+	if (std::abs(level - scanLevel_) > scanLevel_ * kScanLevel) {
+		LOG(IPASoftAf, Debug) << "Level " << level << " was " << scanLevel_
+				      << ", scene moved, scan abandoned";
+		wait(true);
+		return;
+	}
+
+	samples_.emplace_back(position_, measure);
+	if (measure > bestMeasure_) {
+		bestMeasure_ = measure;
+		bestPosition_ = position_;
+	}
+	if (worstMeasure_ == 0.0 || measure < worstMeasure_)
+		worstMeasure_ = measure;
+
+	bool contrast = bestMeasure_ > worstMeasure_ * minContrast_ &&
+			bestMeasure_ > minMeasure_;
+	/* well past a peak: the far side of it will not be sharper */
+	bool pastPeak = contrast && measure < bestMeasure_ * 0.5 &&
+			position_ >= bestPosition_ + 2 * step_;
+
+	if (position_ + step_ <= scanEnd_ && !pastPeak) {
+		moveTo(context, position_ + step_);
+		return;
+	}
+
+	if (phase_ == Phase::Coarse) {
+		if (!contrast) {
+			finish(context, fixedPosition_, false);
+			return;
+		}
+		startFine(context, bestPosition_, coarseStep_ * 2 / 3);
+		return;
+	}
+
+	/* a check around the old position whose best sample is at an end missed the peak */
+	int32_t first = samples_.front().first, last = samples_.back().first;
+	bool atEnd = (bestPosition_ == first && first > min_) ||
+		     (bestPosition_ == last && last < max_);
+	if (atEnd && !fullScan_) {
+		LOG(IPASoftAf, Debug) << "Peak outside the check, full scan";
+		fullScan_ = true;
+		startScan(context, true, level);
+		return;
+	}
+
+	finish(context, peak(), contrast || !fullScan_);
+}
+
+void Af::waitStep(IPAContext &context, double measure, double level)
+{
+	bool exposed = level >= kMinLevel && level <= kMaxLevel;
+	bool still = lastLevel_ > 0.0 &&
+		     std::abs(level - lastLevel_) <= lastLevel_ * kStillLevel &&
+		     std::abs(measure - lastMeasure_) <=
+			     std::max(measure, lastMeasure_) * kStillMeasure;
+
+	lastLevel_ = level;
+	lastMeasure_ = measure;
+	stable_ = exposed && still ? stable_ + 1 : 0;
+	if (stable_ < 2)
+		return;
+
+	startScan(context, fullScan_, level);
+}
+
+void Af::watch(double measure, double level)
+{
+	if (baselineMeasure_ == 0.0) {
+		baselineMeasure_ = measure;
+		baselineLevel_ = level;
+		return;
+	}
+
+	bool dropped = measure < baselineMeasure_ * rescanDrop_;
+	bool relit = std::abs(level - baselineLevel_) > baselineLevel_ * rescanLevel_;
+
+	if (!dropped && !relit) {
+		changed_ = 0;
+		/* follow slow changes */
+		baselineMeasure_ = 0.8 * baselineMeasure_ + 0.2 * measure;
+		baselineLevel_ = 0.8 * baselineLevel_ + 0.2 * level;
+		return;
+	}
+
+	if (++changed_ < rescanSamples_ || mode_ != controls::AfModeContinuous)
+		return;
+
+	LOG(IPASoftAf, Debug)
+		<< "Scene changed (measure " << measure << " was " << baselineMeasure_
+		<< ", level " << level << " was " << baselineLevel_ << ")";
+	wait(dropped || failed_);
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!enabled_)
+		return;
+
+	int32_t state = controls::AfStateIdle;
+	if (phase_ == Phase::Wait || phase_ == Phase::Coarse ||
+	    phase_ == Phase::Fine || phase_ == Phase::Verify)
+		state = controls::AfStateScanning;
+	else if (phase_ == Phase::Focused)
+		state = failed_ ? controls::AfStateFailed : controls::AfStateFocused;
+	metadata.set(controls::AfState, state);
+
+	if (!stats->valid || !stats->sharpnessCount || phase_ == Phase::Idle)
+		return;
+
+	double level = static_cast<double>(stats->sharpnessLevel) / stats->sharpnessCount;
+	if (level < 1.0)
+		return;
+	double measure = static_cast<double>(stats->sharpness) / stats->sharpnessCount /
+			 (level * level);
+
+	switch (phase_) {
+	case Phase::Wait:
+		waitStep(context, measure, level);
+		break;
+	case Phase::Coarse:
+	case Phase::Fine:
+		scanStep(context, measure, level);
+		break;
+	case Phase::Verify:
+		if (approach_) {
+			approach_ = false;
+			moveTo(context, target_);
+			break;
+		}
+		if (measure < bestMeasure_ * kVerify && verifyFailures_ < 2) {
+			LOG(IPASoftAf, Debug) << "Measure " << measure << " at " << position_
+					      << ", scan best " << bestMeasure_ << ": again";
+			verifyFailures_++;
+			wait(true);
+			break;
+		}
+		verifyFailures_ = 0;
+		phase_ = Phase::Focused;
+		watch(measure, level);
+		break;
+	case Phase::Focused:
+		watch(measure, level);
+		break;
+	case Phase::Idle:
+		break;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/af.h b/src/ipa/simple/algorithms/af.h
new file mode 100644
index 0000000..8464192
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus for the software ISP
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/control_ids.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const YamlObject &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Phase { Idle, Wait, Coarse, Fine, Verify, Focused };
+
+	void wait(bool full);
+	void startScan(IPAContext &context, bool full, double level);
+	void startFine(IPAContext &context, int32_t centre, int32_t halfWidth);
+	void moveTo(IPAContext &context, int32_t position);
+	void finish(IPAContext &context, int32_t position, bool found);
+	void scanStep(IPAContext &context, double measure, double level);
+	void waitStep(IPAContext &context, double measure, double level);
+	void watch(double measure, double level);
+	int32_t peak() const;
+
+	/* tuning */
+	int32_t rangeMin_ = -1;
+	int32_t rangeMax_ = -1;
+	int32_t coarseStep_ = 48;
+	int32_t fineStep_ = 16;
+	int32_t fixedPosition_ = -1;
+	double minContrast_ = 1.5;
+	double minMeasure_ = 1e-3;
+	double rescanDrop_ = 0.6;
+	double rescanLevel_ = 0.3;
+	unsigned int rescanSamples_ = 3;
+
+	/* session */
+	bool enabled_ = false;
+	bool fixed_ = false;
+	int32_t min_ = 0, max_ = 0;
+	controls::AfModeEnum mode_ = controls::AfModeContinuous;
+	Phase phase_ = Phase::Idle;
+	bool failed_ = false;
+
+	/* waiting for a still, well exposed scene */
+	bool fullScan_ = true;
+	unsigned int stable_ = 0;
+	double lastMeasure_ = 0.0;
+	double lastLevel_ = 0.0;
+
+	/* scan */
+	int32_t position_ = -1;
+	int32_t scanEnd_ = 0;
+	int32_t step_ = 0;
+	double scanLevel_ = 0.0;
+	std::vector<std::pair<int32_t, double>> samples_;
+	int32_t bestPosition_ = 0;
+	double bestMeasure_ = 0.0;
+	double worstMeasure_ = 0.0;
+	unsigned int verifyFailures_ = 0;
+	/* the chosen position, approached from below like the scans (VCM hysteresis) */
+	int32_t target_ = 0;
+	bool approach_ = false;
+
+	/* focused */
+	double baselineMeasure_ = 0.0;
+	double baselineLevel_ = 0.0;
+	unsigned int changed_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
