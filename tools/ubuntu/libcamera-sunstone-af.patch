@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus for the software ISP
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#include <libcamera/control_ids.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const YamlObject &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Phase { Idle, Coarse, Fine, Focused };
+
+	void startScan();
+	void moveTo(IPAContext &context, int32_t position);
+	void finishScan(IPAContext &context, int32_t position, bool found);
+	void scanStep(IPAContext &context, double measure);
+	void watch(double measure, double level);
+
+	/* tuning */
+	int32_t rangeMin_ = -1;
+	int32_t rangeMax_ = -1;
+	int32_t coarseStep_ = 48;
+	int32_t fineStep_ = 12;
+	int32_t defaultPosition_ = -1;
+	double minContrast_ = 1.2;
+	double rescanDrop_ = 0.6;
+	double rescanLevel_ = 0.3;
+	unsigned int rescanSamples_ = 4;
+	unsigned int startSamples_ = 4;
+
+	/* session */
+	bool enabled_ = false;
+	int32_t min_ = 0, max_ = 0;
+	controls::AfModeEnum mode_ = controls::AfModeContinuous;
+	Phase phase_ = Phase::Idle;
+	bool failed_ = false;
+	unsigned int wait_ = 0;
+
+	/* scan */
+	int32_t position_ = 0;
+	int32_t scanEnd_ = 0;
+	int32_t step_ = 0;
+	int32_t bestPosition_ = 0;
+	double bestMeasure_ = 0.0;
+	double worstMeasure_ = 0.0;
+
+	/* focused */
+	bool haveBaseline_ = false;
+	double baselineMeasure_ = 0.0;
+	double baselineLevel_ = 0.0;
+	unsigned int changed_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
