# gen_init_cpio list (usr/gen_init_cpio): no root needed for device nodes or owners
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/kmsg 0644 0 0 c 1 11
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /run 0755 0 0
dir /tmp 1777 0 0
dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /usr 0755 0 0
dir /usr/bin 0755 0 0
dir /usr/sbin 0755 0 0
dir /lib 0755 0 0
dir /usr/lib 0755 0 0
dir /etc 0755 0 0
dir /root 0700 0 0
dir /root/.ssh 0700 0 0
file /bin/busybox @ROOT@/downloads/alpine/busybox-static/bin/busybox.static 0755 0 0
slink /bin/sh busybox 0777 0 0
file /init @ROOT@/initramfs/init-m2 0755 0 0
# dropbear and busybox-extras (udhcpd) from Alpine, musl, and their libraries
file /bin/busybox-extras @ROOT@/downloads/alpine/busybox-extras/bin/busybox-extras 0755 0 0
file /usr/sbin/dropbear @ROOT@/downloads/alpine/dropbear/usr/sbin/dropbear 0755 0 0
file /usr/bin/dropbearkey @ROOT@/downloads/alpine/dropbear/usr/bin/dropbearkey 0755 0 0
file /lib/ld-musl-aarch64.so.1 @ROOT@/downloads/alpine/musl/lib/ld-musl-aarch64.so.1 0755 0 0
slink /lib/libc.musl-aarch64.so.1 ld-musl-aarch64.so.1 0777 0 0
file /usr/lib/libz.so.1 @ROOT@/downloads/alpine/zlib/usr/lib/libz.so.1.3.2 0755 0 0
file /usr/lib/libutmps.so.0.1 @ROOT@/downloads/alpine/utmps-libs/usr/lib/libutmps.so.0.1.3.3 0755 0 0
file /usr/lib/libskarnet.so.2.15 @ROOT@/downloads/alpine/skalibs-libs/usr/lib/libskarnet.so.2.15.0.0 0755 0 0
file /etc/passwd @ROOT@/initramfs/etc/passwd 0644 0 0
file /etc/group @ROOT@/initramfs/etc/group 0644 0 0
file /etc/shadow @ROOT@/initramfs/etc/shadow 0600 0 0
file /etc/shells @ROOT@/initramfs/etc/shells 0644 0 0
file /etc/profile @ROOT@/initramfs/etc/profile 0644 0 0
file /root/.ssh/authorized_keys @ROOT@/tools/authorized_keys 0600 0 0
