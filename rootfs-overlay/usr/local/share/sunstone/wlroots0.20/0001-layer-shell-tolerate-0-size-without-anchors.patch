From: sunstone-linux
Subject: layer-shell: tolerate a 0 width/height without both anchors (phosh)

phosh's home bar commits its layer surface with size 0x0 anchored left/right/bottom before its
drag surface sets the real height; wlroots rejects that with a protocol error and phosh exits
("height 0 requested without setting top and bottom anchors"). Debian, Fedora and postmarketOS
carry the same relaxation in their wlroots packages; Arch's wlroots0.20 does not.

diff --git a/types/wlr_layer_shell_v1.c b/types/wlr_layer_shell_v1.c
index 2d8384981..876a66073 100644
--- a/types/wlr_layer_shell_v1.c
+++ b/types/wlr_layer_shell_v1.c
@@ -361,19 +361,13 @@ static void layer_surface_role_client_commit(struct wlr_surface *wlr_surface) {
 	const uint32_t horiz = ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT |
 		ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT;
 	if (surface->pending.desired_width == 0 && (anchor & horiz) != horiz) {
-		wlr_surface_reject_pending(wlr_surface, surface->resource,
-			ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_SIZE,
-			"width 0 requested without setting left and right anchors");
-		return;
+		wlr_log(WLR_DEBUG, "layer surface: width 0 without left and right anchors (tolerated, phosh)");
 	}
 
 	const uint32_t vert = ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
 		ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM;
 	if (surface->pending.desired_height == 0 && (anchor & vert) != vert) {
-		wlr_surface_reject_pending(wlr_surface, surface->resource,
-			ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_SIZE,
-			"height 0 requested without setting top and bottom anchors");
-		return;
+		wlr_log(WLR_DEBUG, "layer surface: height 0 without top and bottom anchors (tolerated, phosh)");
 	}
 
 	if ((anchor & surface->pending.exclusive_edge) != surface->pending.exclusive_edge) {
