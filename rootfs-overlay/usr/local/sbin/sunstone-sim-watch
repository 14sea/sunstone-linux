#!/bin/sh
# sunstone: bring the SIM back after the SIM/microSD tray was out (hot swap). The modem then finds
# the USIM again ("detected") but opens no primary GW provisioning session, and ModemManager fails
# the modem as sim-missing for good. Every 10 s: when a slot holds a USIM and no primary session
# exists (two checks in a row, so a session the modem is about to open itself is left alone),
# activate one for that USIM; if ModemManager's modem is gone or failed 40 s later, restart it.
# Same steps as by hand: qmicli --uim-change-provisioning-session, systemctl restart ModemManager.
Q="qmicli -d qrtr://0"
seen=0
while :; do
	sleep 10
	st=$($Q --uim-get-card-status 2>/dev/null) || { seen=0; continue; }
	case $st in *"Primary GW:   session doesn't exist"*) ;; *) seen=0; continue ;; esac
	# the first slot that is present with a USIM application: its slot number and AID
	set -- $(printf '%s\n' "$st" | awk '
		/^Slot \[/ { gsub(/[^0-9]/, "", $2); slot = $2; present = 0 }
		/Card state: .present./ { present = 1 }
		/Application type: .*usim/ { usim = present }
		usim && /Application ID:/ { getline; gsub(/[ \t]/, ""); print slot, $0; exit }')
	[ $# -eq 2 ] || { seen=0; continue; }
	seen=$((seen + 1))
	[ $seen -ge 2 ] || continue
	seen=0
	echo "slot $1: USIM without a primary session, activating ($2)"
	$Q --uim-change-provisioning-session="slot=$1,activate=yes,session-type=primary-gw-provisioning,aid=$2" ||
		continue
	sleep 40
	m=$(mmcli -m any 2>/dev/null) || m=
	case $m in
	"" | *"state: failed"* | *"state: "*failed*)
		echo "ModemManager has no working modem, restarting it"
		systemctl restart ModemManager ;;
	esac
done
