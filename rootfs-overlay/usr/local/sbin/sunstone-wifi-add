#!/bin/sh
# sunstone: add a Wi-Fi network for wpa_supplicant@wlan0 (or NetworkManager, when it runs wlan0)
# interactively, so the passphrase is typed on the phone's console/ssh session only. Stores the
# derived PSK, not the passphrase.
#   ssh -t root@192.168.7.2 sunstone-wifi-add
set -eu
if systemctl -q is-active NetworkManager; then
	# NetworkManager runs wlan0 (tools/ubuntu/wifi-to-networkmanager.sh): it asks for the passphrase
	printf 'SSID: '
	read -r ssid
	exec nmcli --ask device wifi connect "$ssid" ifname wlan0
fi
CONF=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
if [ ! -s "$CONF" ]; then
	printf 'Country code for the regulatory domain (e.g. US, DE, CN): '
	read -r cc
	umask 077
	printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=1\ncountry=%s\n' "$cc" > "$CONF"
fi
printf 'SSID: '
read -r ssid
stty -echo 2>/dev/null || true
printf 'Passphrase (hidden): '
read -r pass
stty echo 2>/dev/null || true
echo
printf '%s\n' "$pass" | wpa_passphrase "$ssid" | grep -v '^\s*#psk=' >> "$CONF"
chmod 600 "$CONF"
# started by udev when wlan0 appears (80-sunstone-wlan0.rules), not from multi-user.target
systemctl restart wpa_supplicant@wlan0.service
echo "added '$ssid'; waiting for an address on wlan0..."
for i in $(seq 30); do
	ip -4 -br addr show wlan0 | grep -q ' [0-9]' && break
	sleep 1
done
ip -4 -br addr show wlan0
