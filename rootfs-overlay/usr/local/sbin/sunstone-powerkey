#!/usr/bin/python3
# sunstone: the power key turns the text console off and on. A blank by the console's own timer
# (consoleblank=) is made a forced one, so that only this key brings the screen back, not any key
# press or kernel message.
# In graphics mode the key is left to the desktop (Phosh handles it), unless GRAPHICS
# (/etc/default/sunstone-powerkey) names the processes of desktops that do not (1: any desktop):
#  - gnome-shell (its power key action is set to nothing, rootfs-overlay-gnome): the key switches
#    mutter's PowerSaveMode (display off through KMS, no drawing) on the session's D-Bus
#  - others, such as Lomiri without Ubuntu Touch's system compositor: the key switches the panel's
#    backlight off and on (bl_power); the compositor keeps drawing, it is not told
# Either way the touchscreens are held (input inhibit) while the screen is off.
import fcntl, glob, os, select, struct, subprocess, sys

TIOCLINUX, KDGETMODE, KD_TEXT = 0x541C, 0x4B3B, 0
TIOCL_UNBLANKSCREEN, TIOCL_BLANKSCREEN, TIOCL_BLANKEDSCREEN = 4, 14, 15
EV_KEY, KEY_POWER = 1, 116
EVENT = struct.Struct('llHHi')
INPUT_PROP_DIRECT = 1 << 1
FB_BLANK_UNBLANK, FB_BLANK_POWERDOWN = 0, 4
GRAPHICS = os.environ.get('GRAPHICS', '').split()

def key_device():
	for d in glob.glob('/sys/class/input/event*'):
		with open(d + '/device/name') as f:
			if f.read().strip() == 'pm8941_pwrkey':
				return '/dev/input/' + os.path.basename(d)
	sys.exit('no pm8941_pwrkey input device')

def tioclinux(tty, sub):
	return fcntl.ioctl(tty, TIOCLINUX, bytearray([sub]))

vts = {}

def text_mode():
	"""is the foreground VT in text mode? (/dev/tty0 is bound to the VT in front when it is opened,
	so the VT is looked up each time; a VT hung up when its desktop session ended is opened again)"""
	with open('/sys/class/tty/tty0/active') as f:
		vt = f.read().strip()
	mode = bytearray(4)
	for attempt in (1, 2):
		if vt not in vts:
			vts[vt] = os.open('/dev/' + vt, os.O_RDWR | os.O_NOCTTY)
		try:
			fcntl.ioctl(vts[vt], KDGETMODE, mode)
			break
		except OSError:
			os.close(vts.pop(vt))
			if attempt == 2:
				raise
	return int.from_bytes(mode, sys.byteorder) == KD_TEXT

def desktop():
	"""(name, uid) of a running desktop whose power key this service handles, or None"""
	for d in glob.glob('/proc/[0-9]*'):
		try:
			with open(d + '/comm') as f:
				name = f.read().strip()
			if name in GRAPHICS or GRAPHICS == ['1'] and name in ('gnome-shell', 'lomiri'):
				return name, os.stat(d).st_uid
		except OSError:
			pass
	return None

def mutter(uid, *args):
	"""a DisplayConfig property call on the session bus of uid"""
	cmd = ['setpriv', '--reuid=%d' % uid, '--regid=%d' % uid, '--init-groups', 'env',
	       'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%d/bus' % uid, 'gdbus', 'call', '--session',
	       '--dest', 'org.gnome.Mutter.DisplayConfig', '--object-path', '/org/gnome/Mutter/DisplayConfig',
	       '--method', 'org.freedesktop.DBus.Properties.' + args[0], 'org.gnome.Mutter.DisplayConfig',
	       'PowerSaveMode'] + list(args[1:])
	return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout

def touch(on):
	for d in glob.glob('/sys/class/input/input*'):
		with open(d + '/properties') as f:
			if int(f.read(), 16) & INPUT_PROP_DIRECT:
				write(d + '/inhibited', 0 if on else 1)

def log(msg):
	print(msg, flush=True)

def write(path, value):
	with open(path, 'w') as f:
		f.write(str(value))

def panel(on):
	"""graphics mode without the desktop's help: backlight on/off, touchscreens released/held"""
	touch(on)
	for p in glob.glob('/sys/class/backlight/*/bl_power'):
		write(p, FB_BLANK_UNBLANK if on else FB_BLANK_POWERDOWN)

key = os.open(key_device(), os.O_RDONLY)
tty = os.open('/dev/tty0', os.O_RDWR | os.O_NOCTTY)
forced = False
panel_off = False	# the backlight, switched off here
gnome_off = None	# the uid of the GNOME session whose display this switched off
while True:
	ready, _, _ = select.select([key], [], [], 1)
	pressed = False
	if ready:
		data = os.read(key, EVENT.size * 64)
		for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
			_, _, type_, code, value = EVENT.unpack_from(data, i)
			pressed |= type_ == EV_KEY and code == KEY_POWER and value == 1
	if not text_mode():
		forced = False
		if gnome_off is not None and not pressed:
			# woken by the desktop itself (another key): release the touchscreen again
			try:
				if '<0>' in mutter(gnome_off, 'Get'):
					touch(True)
					gnome_off = None
					log('GNOME turned its display on again')
			except subprocess.SubprocessError:
				pass
		if not (GRAPHICS and pressed):
			continue
		if panel_off:
			panel(True)
			panel_off = False
			continue
		d = desktop()
		if d and d[0] == 'gnome-shell':
			try:
				off = '<0>' in mutter(d[1], 'Get')
				mutter(d[1], 'Set', '<int32 %d>' % (3 if off else 0))
				touch(not off)
				gnome_off = d[1] if off else None
				log('power key: GNOME display ' + ('off' if off else 'on'))
			except subprocess.SubprocessError:
				pass
		elif d:
			panel(False)
			panel_off = True
		continue
	if gnome_off is not None:
		touch(True)
		gnome_off = None
	if panel_off:
		# the desktop went away with the panel off: give the console its screen back
		panel(True)
		panel_off = False
	blanked = tioclinux(tty, TIOCL_BLANKEDSCREEN) != 0
	if pressed:
		tioclinux(tty, TIOCL_UNBLANKSCREEN if blanked else TIOCL_BLANKSCREEN)
		forced = not blanked
	elif blanked and not forced:
		tioclinux(tty, TIOCL_BLANKSCREEN)
		forced = True
	elif not blanked:
		forced = False
