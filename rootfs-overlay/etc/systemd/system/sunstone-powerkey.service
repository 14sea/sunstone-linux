[Unit]
Description=sunstone power key: text console off/on

[Service]
# GRAPHICS=PROCESS: also in graphics mode while PROCESS (a desktop that does not handle the key) runs
EnvironmentFile=-/etc/default/sunstone-powerkey
ExecStart=/usr/local/sbin/sunstone-powerkey
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
