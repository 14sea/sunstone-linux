[Unit]
Description=sunstone power key: text console off/on

[Service]
# GRAPHICS=1: also in graphics mode (a desktop that does not handle the key itself)
EnvironmentFile=-/etc/default/sunstone-powerkey
ExecStart=/usr/local/sbin/sunstone-powerkey
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
